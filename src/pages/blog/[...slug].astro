---
import Base from '../../layouts/Base.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { data } = post;

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

const url = `https://izayoi-hiroshima.com/blog/${post.id}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  image: data.cover ? `https://izayoi-hiroshima.com${data.cover}` : undefined,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  author: { '@type': 'Organization', name: data.author },
  publisher: {
    '@type': 'Organization',
    name: 'IZAYOI合同会社',
    logo: { '@type': 'ImageObject', url: 'https://izayoi-hiroshima.com/logo.svg' },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  keywords: data.tags.join(', '),
};
---

<Base
  title={`${data.title} — IZAYOI LLC`}
  description={data.description}
  ogType="article"
  ogImage={data.cover}
  jsonLd={jsonLd}
>
  <style>
    .article {
      max-width: 760px;
      margin: 0 auto;
      padding: calc(var(--space-2xl) + 40px) var(--gutter) var(--space-l);
    }

    .article__crumb {
      font-size: clamp(11px, 1.1vw, 13px);
      color: var(--text-muted);
      margin-bottom: var(--space-m);
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .article__crumb a { color: var(--text-secondary); transition: color 0.3s ease; }
    .article__crumb a:hover { color: var(--accent); }
    .article__crumb span { opacity: 0.5; }

    .article__tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: clamp(12px, 1.6vw, 18px); }
    .article__tag {
      font-size: 11px;
      letter-spacing: 0.04em;
      color: var(--accent);
      border: 1px solid currentColor;
      border-radius: 100px;
      padding: 3px 12px;
    }

    .article__title {
      font-size: clamp(28px, 4.4vw, 46px);
      font-weight: 900;
      line-height: 1.3;
      letter-spacing: -0.02em;
      margin-bottom: clamp(12px, 1.6vw, 18px);
    }

    .article__meta { font-size: clamp(12px, 1.1vw, 13.5px); color: var(--text-muted); letter-spacing: 0.05em; }

    .article__cover {
      margin: var(--space-m) 0 0;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid var(--border);
    }
    .article__cover img { width: 100%; height: auto; display: block; }

    /* ===== Markdown 本文タイポグラフィ ===== */
    .prose {
      max-width: 760px;
      margin: var(--space-l) auto 0;
      padding: 0 var(--gutter);
      font-size: clamp(15px, 1.25vw, 17px);
      line-height: 2;
      color: var(--text-primary);
    }

    /* Markdown本文はAstroのコンポーネントスコープ外で生成されるため :global() で当てる */
    .prose :global(> * + *) { margin-top: 1.4em; }

    .prose :global(h2) {
      font-size: clamp(21px, 2.6vw, 28px);
      font-weight: 800;
      letter-spacing: -0.01em;
      line-height: 1.4;
      margin-top: 2.2em;
      padding-top: 0.6em;
      border-top: 1px solid var(--border);
    }

    .prose :global(h3) {
      font-size: clamp(17px, 1.9vw, 21px);
      font-weight: 800;
      margin-top: 1.8em;
    }

    .prose :global(p) { color: var(--text-secondary); }

    .prose :global(a) {
      color: var(--accent);
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-thickness: 1px;
    }
    .prose :global(a:hover) { color: var(--accent-secondary); }

    .prose :global(ul),
    .prose :global(ol) { padding-left: 1.4em; color: var(--text-secondary); }
    .prose :global(li) { margin-top: 0.5em; }
    .prose :global(ul li::marker) { color: var(--accent); }
    .prose :global(ol li::marker) { color: var(--accent); font-weight: 700; }

    .prose :global(blockquote) {
      border-left: 3px solid var(--accent);
      background: var(--bg-secondary);
      border-radius: 0 12px 12px 0;
      padding: clamp(14px, 1.8vw, 20px) clamp(16px, 2vw, 24px);
      font-weight: 600;
      color: var(--text-primary);
    }
    .prose :global(blockquote p) { color: var(--text-primary); margin-top: 0; }

    .prose :global(img) { border-radius: 12px; border: 1px solid var(--border); }

    .prose :global(code) {
      font-family: 'SFMono-Regular', ui-monospace, Menlo, monospace;
      font-size: 0.88em;
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.15em 0.4em;
    }

    .prose :global(pre) {
      background: var(--bg-dark);
      color: var(--text-on-dark);
      border-radius: 12px;
      padding: clamp(16px, 2vw, 22px);
      overflow-x: auto;
    }
    .prose :global(pre code) { background: none; border: none; padding: 0; color: inherit; }

    .prose :global(strong) { font-weight: 800; color: var(--text-primary); }

    /* 記事フッター */
    .article-foot {
      max-width: 760px;
      margin: var(--space-l) auto 0;
      padding: var(--space-l) var(--gutter) 0;
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--space-s);
    }
    .article-foot__back { font-size: 13px; font-weight: 600; color: var(--accent); }
  </style>

  <article>
    <header class="article">
      <nav class="article__crumb hero-anim" aria-label="パンくず">
        <a href="/">ホーム</a><span>/</span><a href="/blog">コラム</a><span>/</span>{data.title}
      </nav>
      <div class="article__tags hero-anim">
        {data.tags.map((t) => <span class="article__tag">{t}</span>)}
      </div>
      <h1 class="article__title hero-anim">{data.title}</h1>
      <p class="article__meta hero-anim">
        {fmt(data.pubDate)} 公開{data.updatedDate && ` ・ ${fmt(data.updatedDate)} 更新`}
      </p>
      {data.cover && (
        <div class="article__cover hero-anim">
          <img src={data.cover} alt={data.title} />
        </div>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    <div class="article-foot">
      <a href="/blog" class="article-foot__back">← コラム一覧へ</a>
    </div>
  </article>

  <ContactCTA sub="AI活用やSNS運用のご相談は、30分無料相談から。" />
</Base>
