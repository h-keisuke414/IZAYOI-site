---
import Base from '../layouts/Base.astro';
import ContactCTA from '../components/ContactCTA.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: '会社概要 — IZAYOI LLC',
  description: 'IZAYOI合同会社について。広島発のデジタルマーケティング会社。代表: 濱田圭佑。',
  url: 'https://izayoi-hiroshima.com/about',
  mainEntity: {
    '@type': 'Organization',
    name: 'IZAYOI合同会社',
    alternateName: 'IZAYOI LLC',
    founder: {
      '@type': 'Person',
      name: '濱田圭佑',
      jobTitle: 'CEO / Founder',
    },
    foundingDate: '2023',
    address: {
      '@type': 'PostalAddress',
      addressLocality: '広島市',
      addressRegion: '広島県',
      addressCountry: 'JP',
    },
    email: 'info@izayoi.co.jp',
    knowsAbout: [
      'デジタルマーケティング',
      'SNS運用代行',
      'Web制作',
      '動画制作',
      'AI導入支援',
    ],
  },
};
---

<Base
  title="About — IZAYOI LLC"
  description="IZAYOI合同会社について。広島発のデジタルマーケティング会社。デジタルの力でブランドの可能性を最大化する。"
  jsonLd={jsonLd}
>
  <style>
    /* ============================================
       NIKE-STYLE FULL HERO
       ============================================ */
    .about-hero {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: clamp(80px, 10vh, 140px) var(--gutter);
      position: relative;
      overflow: hidden;
    }

    .about-hero__glow {
      position: absolute;
      width: 60vw;
      height: 60vw;
      background: radial-gradient(circle, var(--accent) 0%, transparent 70%);
      opacity: 0.06;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
      animation: glowPulse 6s ease-in-out infinite;
    }

    .about-hero__eyebrow {
      font-size: clamp(10px, 1.2vw, 14px);
      font-weight: 500;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: clamp(16px, 3vh, 40px);
      position: relative;
    }

    .about-hero__title {
      font-family: 'Inter', sans-serif;
      font-size: clamp(56px, 13vw, 180px);
      font-weight: 900;
      line-height: 0.88;
      letter-spacing: -0.04em;
      text-transform: uppercase;
      color: var(--text-primary);
      margin-bottom: clamp(20px, 4vh, 48px);
      position: relative;
    }

    .about-hero__title .accent-line {
      display: block;
      background: var(--gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .about-hero__desc {
      font-size: clamp(14px, 1.8vw, 22px);
      font-weight: 300;
      color: var(--text-secondary);
      line-height: 1.8;
      max-width: 640px;
      position: relative;
    }

    .about-hero__scroll {
      position: absolute;
      bottom: clamp(24px, 4vh, 48px);
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      color: var(--text-muted);
      font-size: 10px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }

    .about-hero__scroll::after {
      content: '';
      width: 1px;
      height: 40px;
      background: var(--accent);
      animation: scrollLine 2s ease-in-out infinite;
    }

    @keyframes scrollLine {
      0%, 100% { opacity: 0.3; transform: scaleY(0.5); }
      50% { opacity: 1; transform: scaleY(1); }
    }

    /* ============================================
       PHILOSOPHY EXTENDED
       ============================================ */
    .philosophy-ext {
      text-align: center;
      padding: var(--space-xl) var(--gutter);
      max-width: min(900px, 100%);
      margin: 0 auto;
    }

    .philosophy-ext__label {
      font-size: clamp(10px, 1vw, 12px);
      font-weight: 500;
      letter-spacing: 0.2em;
      color: var(--accent);
      text-transform: uppercase;
      margin-bottom: clamp(8px, 1vw, 16px);
    }

    .philosophy-ext__title {
      font-size: clamp(28px, 4.5vw, 56px);
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -0.02em;
      margin-bottom: var(--space-m);
    }

    .philosophy-ext__quote {
      font-size: clamp(18px, 2.5vw, 32px);
      font-weight: 300;
      line-height: 1.8;
      color: var(--text-primary);
      margin-bottom: var(--space-m);
    }

    .philosophy-ext__quote em {
      font-style: normal;
      background: var(--gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-weight: 700;
    }

    .philosophy-ext__values {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
      gap: clamp(16px, 2vw, 24px);
      margin-top: var(--space-l);
      text-align: left;
    }

    .value-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: clamp(12px, 2vw, 20px);
      padding: clamp(24px, 3vw, 36px);
      transition: all 0.4s ease;
    }

    .value-card:hover {
      background: var(--bg-card-hover);
      border-color: var(--accent);
      transform: translateY(-4px);
    }

    .value-card__title {
      font-size: clamp(16px, 1.5vw, 20px);
      font-weight: 700;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .value-card__title span {
      background: var(--gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-weight: 900;
      font-size: clamp(20px, 2vw, 28px);
    }

    .value-card__desc {
      font-size: clamp(13px, 1.2vw, 14px);
      color: var(--text-secondary);
      line-height: 1.7;
    }

    /* ============================================
       COMPANY INFO TABLE
       ============================================ */
    .company {
      padding: var(--space-xl) var(--gutter);
      max-width: 1280px;
      margin: 0 auto;
      width: 100%;
    }

    .company__table {
      width: 100%;
      border-collapse: collapse;
      margin-top: var(--space-m);
    }

    .company__table tr {
      border-bottom: 1px solid var(--border);
    }

    .company__table th,
    .company__table td {
      padding: clamp(14px, 2vw, 20px) 0;
      text-align: left;
      vertical-align: top;
    }

    .company__table th {
      font-size: clamp(12px, 1.1vw, 14px);
      font-weight: 600;
      color: var(--accent);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      width: clamp(100px, 20%, 200px);
      white-space: nowrap;
    }

    .company__table td {
      font-size: clamp(14px, 1.3vw, 16px);
      color: var(--text-primary);
      line-height: 1.7;
    }

    /* ============================================
       CEO PROFILE
       ============================================ */
    .ceo {
      padding: var(--space-xl) var(--gutter);
      max-width: 1280px;
      margin: 0 auto;
      width: 100%;
    }

    .ceo__inner {
      max-width: 720px;
    }

    .ceo__name {
      font-size: clamp(24px, 3vw, 36px);
      font-weight: 800;
      margin-bottom: 4px;
    }

    .ceo__role {
      font-size: clamp(12px, 1.1vw, 14px);
      font-weight: 500;
      color: var(--accent);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: var(--space-s);
    }

    .ceo__bio {
      font-size: clamp(14px, 1.3vw, 16px);
      color: var(--text-secondary);
      line-height: 1.9;
    }

    .ceo__bio p { margin-bottom: 1em; }
    .ceo__bio p:last-child { margin-bottom: 0; }
  </style>

  <!-- ===== NIKE-STYLE HERO ===== -->
  <section class="about-hero">
    <div class="about-hero__glow"></div>
    <p class="about-hero__eyebrow hero-anim">Who We Are</p>
    <h1 class="about-hero__title hero-anim">
      MAXIMIZE<br>
      <span class="accent-line">YOUR BRAND.</span>
    </h1>
    <p class="about-hero__desc hero-anim">
      広島から、デジタルの力でブランドの可能性を最大化する。<br>
      戦略と実行の両輪で、本質的な成長を共に創る。
    </p>
    <div class="about-hero__scroll hero-anim">Scroll</div>
  </section>

  <!-- ===== PHILOSOPHY ===== -->
  <section class="philosophy-ext">
    <p class="philosophy-ext__label reveal">Philosophy</p>
    <h2 class="philosophy-ext__title reveal">Mission & Vision</h2>
    <p class="philosophy-ext__quote reveal">
      デジタルの力で、<em>ブランドの可能性</em>を最大化する。<br>
      戦略と実行の両輪で、<em>本質的な成長</em>を共に創る。
    </p>
    <div class="philosophy-ext__values reveal-stagger">
      <div class="value-card reveal">
        <h3 class="value-card__title"><span>01</span> Strategy First</h3>
        <p class="value-card__desc">感覚に頼らず、データと戦略に基づいた施策設計。目的から逆算した最適解を提供します。</p>
      </div>
      <div class="value-card reveal">
        <h3 class="value-card__title"><span>02</span> Quality & Speed</h3>
        <p class="value-card__desc">品質とスピードの両立。少数精鋭だからこそ実現できる、高速でハイクオリティなデリバリー。</p>
      </div>
      <div class="value-card reveal">
        <h3 class="value-card__title"><span>03</span> Growth Partner</h3>
        <p class="value-card__desc">外注先ではなく、成長パートナーとして。事業の成功にコミットし、長期的な関係を構築します。</p>
      </div>
    </div>
  </section>

  <!-- ===== COMPANY INFO ===== -->
  <section class="company">
    <div class="section__header reveal">
      <div>
        <p class="section__number">Company</p>
        <h2 class="section__title">会社概要</h2>
      </div>
    </div>
    <table class="company__table reveal">
      <tr>
        <th>社名</th>
        <td>IZAYOI合同会社</td>
      </tr>
      <tr>
        <th>代表</th>
        <td>濱田 圭佑</td>
      </tr>
      <tr>
        <th>設立</th>
        <td>2023年</td>
      </tr>
      <tr>
        <th>所在地</th>
        <td>広島県広島市</td>
      </tr>
      <tr>
        <th>事業内容</th>
        <td>
          SNS運用代行 / HP・Web制作 / 動画制作<br>
          AI導入支援 / SaaS開発 / デジタルマーケティング全般
        </td>
      </tr>
      <tr>
        <th>連絡先</th>
        <td><a href="mailto:info@izayoi.co.jp" style="color:var(--accent);">info@izayoi.co.jp</a></td>
      </tr>
    </table>
  </section>

  <!-- ===== CEO ===== -->
  <section class="ceo">
    <div class="section__header reveal">
      <div>
        <p class="section__number">CEO</p>
        <h2 class="section__title">代表紹介</h2>
      </div>
    </div>
    <div class="ceo__inner">
      <div class="reveal">
        <h3 class="ceo__name">濱田 圭佑</h3>
        <p class="ceo__role">CEO / Founder</p>
        <div class="ceo__bio">
          <p>広島を拠点に、デジタルマーケティング・SNS運用・Web制作・動画制作を手がけるIZAYOI合同会社の代表。</p>
          <p>「デジタルの力で、ブランドの可能性を最大化する」をミッションに、戦略設計から実行・改善まで一気通貫でクライアントの成長を支援。</p>
          <p>最新のAIテクノロジーを積極的に事業に取り入れ、従来のマーケティング手法とテクノロジーを融合させた、新しい価値創造に挑戦し続けています。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CONTACT CTA ===== -->
  <ContactCTA sub="お仕事のご依頼・ご相談、お気軽にお問い合わせください。" />
</Base>
