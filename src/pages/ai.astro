---
import Base from '../layouts/Base.astro';
import ContactCTA from '../components/ContactCTA.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'AI導入支援 — IZAYOI LLC',
  description: '広島の中小企業のための、AI導入伴走プログラム。診断・設計・実装・研修・定着までをひとつのサービスで。SNS・Web・映像の現場で生成AIを使い倒すIZAYOIが伴走します。',
  url: 'https://izayoi-hiroshima.com/ai',
  isPartOf: {
    '@type': 'WebSite',
    name: 'IZAYOI LLC',
    url: 'https://izayoi-hiroshima.com',
  },
  provider: {
    '@type': 'Organization',
    name: 'IZAYOI合同会社',
  },
};

// ひとつの旗艦サービス「AI導入伴走プログラム」に含まれるもの
// （旧・4サービス/8テーマはすべてこのプログラムのモジュールとして内包）
const PROGRAM_MODULES = [
  { id: 'diagnosis', title: '現状診断・AI活用マップ', desc: '業務とマーケティングを棚卸しし、AIが効く場所を優先順位つきで整理します。' },
  { id: 'sns-ai', title: 'マーケティングのAI化', desc: 'SNS・コンテンツ・画像/動画生成・MEO。集客の制作量と質をAIで両立させます。' },
  { id: 'ops', title: '業務自動化・ワークフロー構築', desc: 'レポート・議事録・定型業務をAIワークフローへ。人の時間を判断に返します。' },
  { id: 'training', title: '社内研修・プロンプトの型', desc: '「一部の人だけ使える」を全社の当たり前に。職種別レシピで定着させます。' },
  { id: 'rules', title: '運用ルール整備', desc: '情報管理・利用範囲のガイドラインを整え、安全に使える状態をつくります。' },
  { id: 'dev', title: 'システム・ツール開発', desc: '既製ツールで足りなければ、自社SaaS運営の知見で必要な仕組みごと作ります。' },
  { id: 'review', title: '月次レビュー・改善', desc: '数字と現場の声で効果を確認し、翌月の打ち手まで一緒に決めます。' },
  { id: 'chat', title: 'いつでもチャット相談', desc: '「これAIでできる？」をすぐ聞ける窓口。小さな疑問を溜めません。' },
];

// 絶対に買ってほしい人＝この商品が刺さる会社
const TARGETS = [
  'ChatGPTやClaudeを契約したが、一部の社員しか使っていない',
  '生成AIを業務に活かしたいが、何から始めるべきか分からない',
  '毎月のレポート・議事録・定型業務に時間を取られている',
  'SNSやWebの運用に人手が回っていない',
  'ツール導入で終わらせず、定着まで伴走してほしい',
  '広島（または中国地方）で、顔の見える相手に頼みたい',
];

const REASONS = [
  {
    title: '自分たちが毎日使っている',
    desc: 'このサイトの映像もビジュアルも、実務のレポートも生成AI。売る前に、まず自分たちの現場で使い倒しているのが私たちです。',
  },
  {
    title: 'マーケティングに直結する',
    desc: 'SNS運用・Web制作・動画制作の会社だからこそ、AIを「集客と売上につながる形」で設計できます。ツール導入で終わらせません。',
  },
  {
    title: '開発まで一気通貫',
    desc: '既製ツールで足りなければ、自社SaaSを運営する開発チームがワークフローやアプリごと作ります。提案から実装まで窓口はひとつ。',
  },
];

const FLOW = [
  { step: '01', title: '30分無料相談', desc: '現状の課題やお困りごとを、オンラインで気軽にお聞かせください。' },
  { step: '02', title: '現状整理・診断', desc: '業務フローとマーケティングの現状を拝見し、AIが効く場所を整理します。' },
  { step: '03', title: 'テーマ選定・小さく検証', desc: '効果の出やすいテーマから優先順位をつけ、小さく試して手応えを確認します。' },
  { step: '04', title: '設計・実装', desc: 'ワークフローの設計、ツールの整備、必要ならシステム開発まで実行します。' },
  { step: '05', title: '定着・改善の伴走', desc: '使われ続ける状態まで運用ルールと研修で支え、月次で改善を回します。' },
];
---

<Base
  title="AI導入支援 — IZAYOI LLC"
  description="広島の中小企業のための、AI導入伴走プログラム。診断・設計・実装・研修・定着までをひとつのサービスで伴走します。"
  jsonLd={jsonLd}
>
  <style>
    /* ============================================
       PAGE HERO — 左寄せ（TSUQREA型）
       ============================================ */
    .ai-hero {
      max-width: 1200px;
      margin: 0 auto;
      padding: calc(var(--space-2xl) + 40px) var(--gutter) var(--space-l);
      position: relative;
    }

    .ai-hero__eyebrow {
      font-size: clamp(10px, 1.2vw, 13px);
      font-weight: 500;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: var(--space-s);
    }

    .ai-hero__title {
      font-size: clamp(34px, 5vw, 60px);
      font-weight: 900;
      letter-spacing: -0.02em;
      line-height: 1.2;
      margin-bottom: clamp(14px, 1.8vw, 22px);
    }

    .ai-hero__statement {
      font-size: clamp(19px, 2.4vw, 30px);
      font-weight: 700;
      line-height: 1.6;
      margin-bottom: clamp(18px, 2.4vw, 30px);
    }

    .ai-hero__desc {
      font-size: clamp(13px, 1.25vw, 15px);
      color: var(--text-secondary);
      line-height: 2.05;
      max-width: 720px;
    }

    .ai-hero__desc + .ai-hero__desc { margin-top: 1em; }

    .ai-hero__cta { margin-top: var(--space-m); }

    /* ============================================
       SECTIONS
       ============================================ */
    .ai-sec {
      position: relative;
      max-width: 1200px;
      margin: 0 auto;
      padding: var(--space-l) var(--gutter);
      overflow: visible;
      scroll-margin-top: 90px;
    }

    .ai-sec--full { max-width: none; background: var(--bg-secondary); }
    .ai-sec--full > .ai-sec__inner { max-width: 1200px; margin: 0 auto; }

    .ai-sec__title {
      font-size: clamp(22px, 3vw, 36px);
      font-weight: 800;
      letter-spacing: -0.01em;
      margin-bottom: clamp(10px, 1.4vw, 16px);
    }

    .ai-sec__lede {
      font-size: clamp(12.5px, 1.2vw, 14.5px);
      color: var(--text-secondary);
      line-height: 2;
      max-width: 640px;
      margin-bottom: var(--space-m);
    }

    /* 対象（絶対に買ってほしい人） */
    .ai-targets {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: clamp(20px, 2.6vw, 36px);
    }

    .ai-targets ul {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
      gap: 12px clamp(16px, 2.5vw, 40px);
    }

    .ai-targets li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: clamp(12.5px, 1.15vw, 14px);
      color: var(--text-secondary);
      line-height: 1.8;
    }

    .ai-targets li::before {
      content: '';
      flex-shrink: 0;
      width: 7px;
      height: 7px;
      margin-top: 9px;
      border-radius: 50%;
      background: var(--accent-secondary);
    }

    /* プログラム（唯一の商品） */
    .ai-program {
      border: 1px solid var(--border);
      border-radius: 20px;
      background: var(--bg-card);
      padding: clamp(24px, 3.4vw, 56px);
      position: relative;
      overflow: hidden;
    }

    .ai-program__badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent);
      border: 1px solid var(--accent-secondary);
      border-radius: 100px;
      padding: 6px 16px;
      margin-bottom: clamp(14px, 1.8vw, 22px);
    }

    .ai-program__name {
      font-size: clamp(24px, 3.2vw, 40px);
      font-weight: 900;
      letter-spacing: -0.02em;
      line-height: 1.25;
      margin-bottom: clamp(10px, 1.4vw, 16px);
    }

    .ai-program__statement {
      font-size: clamp(15px, 1.6vw, 19px);
      font-weight: 700;
      line-height: 1.7;
      margin-bottom: clamp(12px, 1.6vw, 18px);
    }

    .ai-program__desc {
      font-size: clamp(13px, 1.2vw, 14.5px);
      color: var(--text-secondary);
      line-height: 2.05;
      max-width: 760px;
    }

    .ai-program__includes-title {
      font-size: clamp(16px, 1.6vw, 20px);
      font-weight: 800;
      margin: var(--space-m) 0 var(--space-s);
    }

    .ai-program__grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
      gap: clamp(10px, 1.3vw, 14px);
    }

    @media (min-width: 960px) { .ai-program__grid { grid-template-columns: repeat(2, 1fr); } }

    .ai-program__cta { margin-top: var(--space-m); display: flex; gap: 12px; flex-wrap: wrap; }

    /* 料金 */
    .ai-price {
      margin-top: var(--space-m);
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 8px 16px;
      border: 1px solid var(--border);
      border-left: 3px solid var(--accent);
      border-radius: 12px;
      background: var(--bg-primary);
      padding: clamp(18px, 2.2vw, 26px);
    }

    .ai-price__label {
      width: 100%;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent);
    }

    .ai-price__amount { font-size: clamp(24px, 3vw, 36px); font-weight: 900; letter-spacing: -0.02em; }
    .ai-price__unit { font-size: clamp(13px, 1.2vw, 15px); color: var(--text-secondary); font-weight: 600; }
    .ai-price__note { width: 100%; font-size: clamp(11.5px, 1.05vw, 13px); color: var(--text-muted); line-height: 1.7; }

    /* 違う理由 3カード */
    .ai-reasons {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
      gap: clamp(10px, 1.4vw, 16px);
    }

    .reason-card {
      border-top: 1px solid var(--text-primary);
      padding-top: clamp(14px, 1.8vw, 20px);
    }

    .reason-card__num { font-size: clamp(11px, 1vw, 12px); letter-spacing: 0.18em; color: var(--accent); margin-bottom: 8px; }
    .reason-card__title { font-size: clamp(16px, 1.6vw, 20px); font-weight: 800; margin-bottom: 8px; }
    .reason-card__desc { font-size: clamp(12.5px, 1.1vw, 14px); color: var(--text-secondary); line-height: 1.95; }

    /* ご支援の流れ（縦ステップ） */
    .ai-flow__list {
      max-width: 720px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
    }

    .flow__item {
      position: relative;
      display: grid;
      grid-template-columns: 56px 1fr;
      gap: clamp(14px, 2vw, 24px);
      padding: clamp(18px, 2vw, 26px) 0;
    }

    .flow__item:not(:last-child)::after {
      content: '';
      position: absolute;
      left: 27px;
      top: calc(clamp(18px, 2vw, 26px) + 56px);
      bottom: 0;
      width: 1px;
      background: var(--border);
    }

    .flow__num {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      border: 1px solid var(--border);
      background: var(--bg-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 700;
      color: var(--text-muted);
      letter-spacing: 0.05em;
      transition: background 0.45s ease, color 0.45s ease, border-color 0.45s ease, box-shadow 0.45s ease;
    }

    .flow__title {
      font-size: clamp(15px, 1.5vw, 18px);
      font-weight: 700;
      margin-bottom: 4px;
      padding-top: 4px;
      color: var(--text-muted);
      transition: color 0.45s ease;
    }

    .flow__desc {
      font-size: clamp(12.5px, 1.15vw, 14px);
      color: var(--text-muted);
      line-height: 1.8;
      transition: color 0.45s ease;
    }

    .flow__item.is-active .flow__num {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
      box-shadow: 0 0 0 6px var(--accent-glow);
    }

    .flow__item.is-active .flow__title { color: var(--text-primary); }
    .flow__item.is-active .flow__desc { color: var(--text-secondary); }
  </style>

  <!-- ===== PAGE HERO ===== -->
  <section class="ai-hero">
    <span class="watermark" aria-hidden="true">AI</span>
    <p class="ai-hero__eyebrow hero-anim">AI Adoption</p>
    <h1 class="ai-hero__title hero-anim">AI導入支援</h1>
    <p class="ai-hero__statement hero-anim">
      「AIで会社が回る」状態まで、<br />ひとつのプログラムで伴走します。
    </p>
    <p class="ai-hero__desc hero-anim">
      研修だけ、ツール導入だけ、コンサルだけ——バラバラに頼んでも、AIは現場に根づきません。
      IZAYOIのAI導入支援は、診断から設計・実装・研修・定着までを
      <strong>ひとつの伴走プログラム</strong>にまとめた、それだけを売る商品です。
    </p>
    <p class="ai-hero__desc hero-anim">
      私たちはSNS運用・Web・映像の制作現場で、自ら生成AIを毎日使い倒している広島の会社です。
      このサイトの映像も、背景の生成アートも、その実践の一部。
      「導入すること」ではなく、集客・売上・業務負荷の削減という実際の成果につなげます。
    </p>
    <div class="ai-hero__cta hero-anim">
      <a href="/contact" class="btn-dark">30分無料相談を予約 →</a>
      <a href="#program" class="btn-ghost">プログラムの中身を見る ↓</a>
    </div>
  </section>

  <!-- ===== 対象（絶対に買ってほしい人） ===== -->
  <section class="ai-sec" id="targets">
    <h2 class="ai-sec__title reveal">こんな会社のための、サービスです</h2>
    <p class="ai-sec__lede reveal">
      全部の会社には合いません。次のどれかに当てはまるなら、力になれます。
    </p>
    <div class="ai-targets reveal">
      <ul>
        {TARGETS.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>

  <!-- ===== プログラム（唯一の商品） ===== -->
  <section class="ai-sec" id="program">
    <span class="watermark" aria-hidden="true">PROGRAM</span>
    <div class="ai-program reveal">
      <span class="ai-program__badge">The Only Service — 商品はこれひとつ</span>
      <h2 class="ai-program__name">AI導入伴走プログラム</h2>
      <p class="ai-program__statement">
        診断 → 設計 → 実装 → 研修 → 定着。<br />
        会社にAIが根づくまでの全工程を、月額の伴走でまとめて引き受けます。
      </p>
      <p class="ai-program__desc">
        メニューを細かく分けて売ることはしません。会社ごとに効く場所が違うからです。
        診断で優先順位を決め、効果の出やすいところから小さく実装し、
        使われ続ける状態になるまで研修とルール整備で支える——この一連をひとつの契約で回します。
      </p>

      <h3 class="ai-program__includes-title">プログラムに含まれるもの</h3>
      <div class="ai-program__grid reveal-stagger">
        {PROGRAM_MODULES.map((m) => (
          <div class="tile reveal" id={m.id}>
            <h4 class="tile__title"><span class="tile__arrow">→</span>{m.title}</h4>
            <p class="tile__desc">{m.desc}</p>
          </div>
        ))}
      </div>

      <div class="ai-price reveal">
        <span class="ai-price__label">料金の目安</span>
        <span class="ai-price__amount">月額 100,000円</span>
        <span class="ai-price__unit">〜（税別）</span>
        <span class="ai-price__note">
          支援範囲・貴社の規模により個別にお見積もりします。単発の研修や診断のみのご相談、補助金の活用もお気軽に。
        </span>
      </div>

      <div class="ai-program__cta reveal">
        <a href="/contact" class="btn-dark">30分無料相談を予約 →</a>
      </div>
    </div>
  </section>

  <!-- ===== IZAYOIのAI支援が違う理由 ===== -->
  <section class="ai-sec" id="why">
    <span class="watermark" aria-hidden="true">WHY US</span>
    <h2 class="ai-sec__title reveal">IZAYOIのAI支援が違う理由</h2>
    <p class="ai-sec__lede reveal">
      コンサルでも、ツール販売でもありません。「作って、使って、成果を出す」会社としての支援です。
    </p>
    <div class="ai-reasons reveal-stagger">
      {REASONS.map((r, i) => (
        <div class="reason-card reveal">
          <p class="reason-card__num">0{i + 1}</p>
          <h3 class="reason-card__title">{r.title}</h3>
          <p class="reason-card__desc">{r.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ===== ご支援の流れ ===== -->
  <section class="ai-sec ai-sec--full" id="flow">
    <div class="ai-sec__inner">
      <span class="watermark" aria-hidden="true">FLOW</span>
      <h2 class="ai-sec__title reveal">ご支援の流れ</h2>
      <p class="ai-sec__lede reveal">
        いきなり大きく導入せず、小さく試して確かめながら進めます。
      </p>
      <div class="ai-flow__list reveal-stagger">
        {FLOW.map((f) => (
          <div class="flow__item reveal">
            <div class="flow__num">{f.step}</div>
            <div>
              <h3 class="flow__title">{f.title}</h3>
              <p class="flow__desc">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== CONTACT CTA ===== -->
  <ContactCTA sub="「うちの業務だとどこから？」の段階から、お気軽にどうぞ。" />

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    // ご支援の流れ: スクロール位置と連動してステップが点灯
    gsap.utils.toArray<HTMLElement>('.flow__item').forEach((item) => {
      ScrollTrigger.create({
        trigger: item,
        start: 'top 60%',
        end: 'bottom 35%',
        toggleClass: { targets: item, className: 'is-active' },
      });
    });
  </script>
</Base>
