  <!-- ===== CONTACT CTA ===== -->
  <ContactCTA sub="30分の無料相談から。プロジェクトのご相談、お気軽にどうぞ。" />

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // === HERO: 文字を1文字ずつ立ち上げる ===
    function splitChars(el: Element) {
      const walk = (node: Node) => {
        if (node.nodeType === Node.TEXT_NODE && node.textContent?.trim()) {
          const frag = document.createDocumentFragment();
          for (const ch of node.textContent) {
            const span = document.createElement('span');
            span.className = 'char';
            span.textContent = ch;
            frag.appendChild(span);
          }
          node.parentNode?.replaceChild(frag, node);
        } else if (node.nodeType === Node.ELEMENT_NODE && (node as Element).tagName !== 'BR') {
          [...node.childNodes].forEach(walk);
        }
      };
      walk(el);
    }

    // === HERO: ローダー明け → タイトル文字プルアップ + 順次リビール ===
    const heroTitle = document.getElementById('heroTitle');
    let heroStarted = false;
    function startHero() {
      if (heroStarted || reduceMotion) return;
      heroStarted = true;
      if (heroTitle) {
        splitChars(heroTitle);
        gsap.fromTo(
          '#heroTitle .char',
          { yPercent: 110, opacity: 0 },
          { yPercent: 0, opacity: 1, duration: 0.9, ease: 'power4.out', stagger: 0.03, delay: 0.1 }
        );
      }
      gsap.fromTo(
        '.hero [data-hero-reveal]',
        { opacity: 0, y: 16 },
        { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out', stagger: 0.12, delay: 0.5 }
      );
    }

    // === LOADER: 初回セッションのみ・実ロードに追従しつつ最長1.6秒で必ず明ける ===
    const loader = document.getElementById('loader');
    const loaderSeen = (() => {
      try { return sessionStorage.getItem('izayoi-loader'); } catch { return '1'; }
    })();
    if (loader && (reduceMotion || loaderSeen)) {
      loader.remove();
      startHero();
    } else if (loader) {
      try { sessionStorage.setItem('izayoi-loader', '1'); } catch {}
      const loaderFill = document.getElementById('loaderFill')!;
      const loaderNum = document.getElementById('loaderNum')!;
      let assetsReady = false;
      Promise.race([
        new Promise<void>((r) => window.addEventListener('load', () => r(), { once: true })),
        new Promise<void>((r) => setTimeout(r, 1400)),
      ]).then(() => { assetsReady = true; });
      let lp = 0;
      const lt0 = performance.now();
      (function loaderTick() {
        // 実ロード完了までは86%で待機、完了で100%へ
        const target = assetsReady ? 100 : Math.min(86, (performance.now() - lt0) / 11);
        lp += (target - lp) * 0.14;
        if (lp > 99.2) lp = 100;
        loaderFill.style.width = `${lp}%`;
        loaderNum.textContent = String(Math.round(lp)).padStart(3, '0');
        if (lp < 100) requestAnimationFrame(loaderTick);
        else {
          loader.classList.add('done');
          startHero();
          setTimeout(() => loader.remove(), 650);
        }
      })();
    } else {
      startHero();
    }

    // === HERO: 月光グローがカーソルを追う（軽い没入） ===
    const heroGlow = document.getElementById('heroGlow');
    const heroFrame = document.getElementById('heroFrame');
    if (heroGlow && heroFrame && !reduceMotion && window.matchMedia('(pointer: fine)').matches) {
      let gtx = heroFrame.clientWidth * 0.55;
      let gty = heroFrame.clientHeight * 0.42;
      let ggx = gtx, ggy = gty;
      window.addEventListener('pointermove', (e) => {
        const r = heroFrame.getBoundingClientRect();
        gtx = e.clientX - r.left;
        gty = e.clientY - r.top;
      });
      (function glowFrame() {
        ggx += (gtx - ggx) * 0.055;
        ggy += (gty - ggy) * 0.055;
        heroGlow.style.transform = `translate(${ggx.toFixed(1)}px, ${ggy.toFixed(1)}px)`;
        requestAnimationFrame(glowFrame);
      })();
    }

    // === HERO: スクロールで沈み込みながら白セクションへ ===
    if (!reduceMotion) {
      gsap.to('.hero__bottom, .hero__eyebrow', {
        y: -70,
        opacity: 0,
        ease: 'none',
        scrollTrigger: { trigger: '.hero', start: '15% top', end: 'bottom top', scrub: true },
      });
      gsap.to('.hero__frame', {
        scale: 0.965,
        ease: 'none',
        scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true },
      });
    }

    // === BRUSH: スクロールで描かれる筆ストローク（Lusionの線画オマージュ） ===
    document.querySelectorAll<SVGPathElement>('.brush-arc path').forEach((path) => {
      const len = path.getTotalLength();
      path.style.strokeDasharray = `${len}`;
      if (reduceMotion) return;
      path.style.strokeDashoffset = `${len}`;
      gsap.to(path, {
        strokeDashoffset: 0,
        ease: 'none',
        scrollTrigger: {
          trigger: path.closest('section') || path,
          start: 'top 78%',
          end: 'center 42%',
          scrub: 0.6,
        },
      });
    });

    // === AI導入支援: カードのスタガー表示（ピン留めなしの通常スクロール） ===
    const aiTiles = gsap.utils.toArray<HTMLElement>('#aiGrid .tile');
    if (aiTiles.length && !reduceMotion) {
      gsap.set(aiTiles, { opacity: 0, y: 26 });
      ScrollTrigger.batch(aiTiles, {
        start: 'top 86%',
        onEnter: (batch) => gsap.to(batch, { opacity: 1, y: 0, duration: 0.7, stagger: 0.09, ease: 'power2.out' }),
        once: true,
      });
    }

    // === VISION: スクロールに合わせて文字が塗られていく ===
    const philosophyText = document.getElementById('philosophyText');
    if (philosophyText && !reduceMotion) {
      splitChars(philosophyText);
      const chars = philosophyText.querySelectorAll('.char');
      gsap.to(chars, {
        color: (_i: number, el: Element) =>
          el.closest('.accent-word')
            ? getComputedStyle(document.documentElement).getPropertyValue('--accent').trim()
            : getComputedStyle(document.documentElement).getPropertyValue('--text-primary').trim(),
        ease: 'none',
        stagger: 0.35,
        scrollTrigger: {
          trigger: philosophyText,
          start: 'top 80%',
          end: 'bottom 45%',
          scrub: 0.4,
        },
      });
    }

    // === ご支援の流れ: スクロール位置と連動してステップが点灯 ===
    gsap.utils.toArray<HTMLElement>('.flow__item').forEach((item) => {
      ScrollTrigger.create({
        trigger: item,
        start: 'top 60%',
        end: 'bottom 35%',
        toggleClass: { targets: item, className: 'is-active' },
      });
    });

  </script>
