---
import Base from '../layouts/Base.astro';
import ContactCTA from '../components/ContactCTA.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'IZAYOI LLC',
  alternateName: 'IZAYOI合同会社',
  url: 'https://izayoi-hiroshima.com',
  description: '広島発のデジタルマーケティング会社。AI活用支援・SNS運用代行・HP制作・動画制作・SaaS開発。',
  publisher: {
    '@type': 'Organization',
    name: 'IZAYOI合同会社',
    logo: {
      '@type': 'ImageObject',
      url: 'https://izayoi-hiroshima.com/logo.svg',
    },
  },
};

const NEWS = [
  { date: '2026.07', tag: 'お知らせ', text: 'コーポレートサイトをリニューアルしました' },
  { date: '2026.05', tag: '事例', text: 'TikTok Shop運用支援・EC販売プロジェクトが始動しました' },
];

const AI_THEMES = [
  { title: 'SNS運用 × AI', desc: '企画・投稿・分析のサイクルにAIを組み込み、運用の質と量を両立させます。' },
  { title: 'AI画像・動画生成', desc: '生成AIで広告クリエイティブやブランドムービーを制作。撮影だけに頼らない表現を。' },
  { title: 'コンテンツ制作の自動化', desc: 'キャプション・記事・企画案の下書きをAIで量産し、人は磨きに集中します。' },
  { title: 'LINE構築・CRM', desc: 'LINE公式アカウントの設計から顧客管理・自動応答まで一気通貫で構築します。' },
  { title: 'MEO・ローカル集客', desc: 'Googleビジネスプロフィールの運用・口コミ管理をAIで効率化し来店に繋げます。' },
  { title: 'レポート・分析の自動化', desc: 'SNS・広告・売上データの集計とレポート作成を自動化し、意思決定を速くします。' },
  { title: '業務効率化・自動化', desc: '議事録・請求・スケジュール管理など、日々の定型業務をAIワークフローに。' },
  { title: 'AI内製化・研修', desc: 'ChatGPT・Claude等の社内活用を定着させる導入設計と研修を伴走で支援します。' },
];

const SERVICES = [
  {
    title: 'SNS運用代行',
    en: 'Social Media',
    img: '/img/service-sns.jpg',
    desc: 'Instagram・TikTokを中心に、アカウント戦略の設計からコンテンツ企画・撮影・編集・投稿代行・月次分析まで、専属チームがワンストップで伴走します。飲食・美容・不動産・ECなど広島の多業種で運用実績。',
    tags: ['アカウント戦略設計', 'コンテンツ企画', '撮影・編集', '投稿代行', '月次レポート'],
    href: '/services#sns',
  },
  {
    title: 'HP・Web制作',
    en: 'Web Design & Dev',
    img: '/img/service-web.jpg',
    desc: 'ブランドの世界観を反映したコーポレートサイト・店舗サイト・LP・採用サイトを、設計から高速で美しい実装、公開後の更新運用まで。SNSやMEOと連動した「集客まで見据えた」サイトを作ります。',
    tags: ['コーポレートサイト', 'LP', '採用サイト', 'ECサイト', '保守・更新運用'],
    href: '/services#web',
  },
  {
    title: '動画制作',
    en: 'Video Production',
    img: '/img/service-video.jpg',
    desc: 'ショート動画（リール・TikTok）からPV・ブランドムービー・ルームツアーまで、企画構成・撮影・編集をワンストップで。生成AIを組み合わせた新しい映像表現にも対応します。',
    tags: ['ショート動画', 'PV・ブランドムービー', 'ルームツアー', 'AI動画生成'],
    href: '/services#video',
  },
  {
    title: 'SaaS・アプリ開発',
    en: 'Product Development',
    img: '/img/service-saas.jpg',
    desc: '業務の課題からツールを設計・開発。AIを組み込んだプロダクト開発と、自社SaaSを運営して得た「作って育てる」知見で、構想からMVP・運用まで一気通貫で支援します。',
    tags: ['業務システム', 'AIプロダクト', 'MVP開発', '自社SaaS運営の知見'],
    href: '/services#saas',
  },
];

const PRODUCTS = [
  { name: 'Rheo', kana: 'レオ', desc: '動画・写真・PDFをアップして共有URLを発行する、制作現場のためのファイル共有SaaS。', url: 'https://pantarhei.studio' },
  { name: 'IZAYOI Hub', kana: 'イザヨイ ハブ', desc: 'SNS運用の進行・承認・レポートを一元管理する運用チーム向けアプリ。', url: null },
  { name: 'IZAYOI Fit', kana: 'イザヨイ フィット', desc: 'LINEで完結するAI食事管理サービス。写真を送るだけで栄養バランスを解析。', url: null },
];

const FLOW = [
  { step: '01', title: '30分無料相談', desc: '現状の課題やお困りごとを、オンラインで気軽にお聞かせください。' },
  { step: '02', title: '現状ヒアリング・診断', desc: 'SNSアカウント・Web・業務フローを拝見し、伸びしろを整理します。' },
  { step: '03', title: 'テーマ選定・ご提案', desc: '効果の出やすいテーマから優先順位をつけ、KPIと合わせてご提案します。' },
  { step: '04', title: '設計・制作', desc: '戦略設計からクリエイティブ制作・システム構築まで実行します。' },
  { step: '05', title: '運用・改善の伴走', desc: '月次レポートと改善提案で、成果が出るまで並走します。' },
];
---

<Base
  title="IZAYOI LLC — デジタルとアートで、ブランドを前進させる"
  description="広島発のデジタルマーケティング会社。AI活用支援・SNS運用代行・HP制作・動画制作・SaaS開発で、ブランドの可能性を最大化。"
  jsonLd={jsonLd}
>
  <style>
    /* ============================================
       HERO — 暗転の見せ場①（星雲動画）
       ============================================ */
    .hero {
      position: relative;
      min-height: 92vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      overflow: hidden;
      background: var(--bg-dark);
      padding: var(--space-2xl) var(--gutter);
    }

    .hero__video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.6;
    }

    .hero__scrim {
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at center, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.55) 100%);
      pointer-events: none;
    }

    .hero__inner { position: relative; z-index: 2; }

    .hero__eyebrow {
      font-size: clamp(10px, 1.2vw, 13px);
      font-weight: 500;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--accent-secondary);
      margin-bottom: var(--space-s);
    }

    .hero__title {
      color: var(--text-on-dark);
      font-size: clamp(34px, 5.6vw, 72px);
      font-weight: 900;
      line-height: 1.25;
      letter-spacing: -0.02em;
      margin-bottom: var(--space-s);
    }

    .hero__title .accent {
      background: linear-gradient(135deg, #E8B86D, #C4883C);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero__sub {
      color: rgba(240, 236, 227, 0.78);
      font-size: clamp(13px, 1.4vw, 16px);
      font-weight: 300;
      line-height: 2;
      max-width: 560px;
      margin: 0 auto var(--space-m);
    }

    .hero__scroll {
      position: absolute;
      bottom: clamp(20px, 4vw, 40px);
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      color: rgba(240, 236, 227, 0.5);
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      z-index: 2;
    }

    .hero__scroll-line {
      width: 1px;
      height: clamp(32px, 4vw, 48px);
      background: rgba(240, 236, 227, 0.25);
      position: relative;
      overflow: hidden;
    }

    .hero__scroll-line::after {
      content: '';
      position: absolute;
      top: -100%;
      left: 0;
      width: 100%;
      height: 100%;
      background: var(--accent-secondary);
      animation: scrollLine 2s ease infinite;
    }

    @keyframes scrollLine {
      0% { top: -100%; }
      50% { top: 100%; }
      100% { top: 100%; }
    }

    /* 共通: セクションにウォーターマークを重ねるための下地 */
    .section { position: relative; }
    .section > * { position: relative; z-index: 1; }
    .section .watermark { z-index: 0; }

    /* ============================================
       NEWS
       ============================================ */
    .news { display: grid; grid-template-columns: 220px 1fr; gap: var(--space-m); align-items: start; }

    .news__list { display: flex; flex-direction: column; }

    .news__item {
      display: flex;
      align-items: baseline;
      gap: clamp(14px, 2vw, 28px);
      padding: clamp(14px, 1.6vw, 20px) 4px;
      border-bottom: 1px solid var(--border);
      font-size: clamp(13px, 1.2vw, 15px);
    }

    .news__item:first-child { border-top: 1px solid var(--border); }
    .news__date { color: var(--text-muted); font-size: clamp(11px, 1vw, 13px); letter-spacing: 0.05em; flex-shrink: 0; }
    .news__tag {
      font-size: 10px; letter-spacing: 0.1em; color: var(--accent);
      border: 1px solid currentColor; border-radius: 100px; padding: 2px 10px; flex-shrink: 0;
    }

    @media (max-width: 768px) {
      .news { grid-template-columns: 1fr; gap: var(--space-s); }
    }

    /* ============================================
       AI SUPPORT — メイン事業（キービジュアル + 8カード）
       ============================================ */
    .ai-layout {
      display: grid;
      grid-template-columns: minmax(260px, 340px) 1fr;
      gap: clamp(20px, 3vw, 40px);
      align-items: start;
    }

    .ai-visual {
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid var(--border);
      animation: visualFloat 8s ease-in-out infinite alternate;
    }

    .ai-visual img { width: 100%; height: auto; display: block; }

    @keyframes visualFloat {
      from { transform: translateY(0); }
      to { transform: translateY(-12px); }
    }

    @media (prefers-reduced-motion: reduce) {
      .ai-visual { animation: none; }
    }

    .ai-visual__caption {
      position: absolute;
      left: 14px;
      bottom: 12px;
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .ai-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
      gap: clamp(10px, 1.4vw, 16px);
    }

    @media (min-width: 900px) {
      .ai-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 900px) {
      .ai-layout { grid-template-columns: 1fr; }
      .ai-visual { max-width: 420px; }
    }

    /* ============================================
       SERVICES — 事業内容（画像付き4カラム）
       ============================================ */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(270px, 100%), 1fr));
      gap: clamp(12px, 1.6vw, 20px);
    }

    @media (min-width: 1000px) {
      .services-grid { grid-template-columns: repeat(4, 1fr); }
    }

    .service-col {
      display: flex;
      flex-direction: column;
      border: 1px solid var(--border);
      border-radius: 14px;
      overflow: hidden;
      background: var(--bg-card);
      transition: border-color 0.3s ease, transform 0.3s ease;
    }

    .service-col:hover { border-color: var(--accent-secondary); transform: translateY(-3px); }

    .service-col__img {
      aspect-ratio: 16 / 10;
      overflow: hidden;
      border-bottom: 1px solid var(--border);
    }

    .service-col__img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s ease;
    }

    .service-col:hover .service-col__img img { transform: scale(1.04); }

    .service-col__body {
      padding: clamp(18px, 2vw, 24px);
      display: flex;
      flex-direction: column;
      gap: 10px;
      flex: 1;
    }

    .service-col__en {
      font-size: 10px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--accent);
    }

    .service-col__title { font-size: clamp(16px, 1.6vw, 19px); font-weight: 800; }

    .service-col__desc {
      font-size: clamp(12px, 1.05vw, 13.5px);
      color: var(--text-secondary);
      line-height: 1.9;
      flex: 1;
    }

    .service-col__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .service-col__tags span {
      font-size: 10.5px;
      letter-spacing: 0.04em;
      color: var(--text-secondary);
      border: 1px solid var(--border);
      background: var(--bg-primary);
      border-radius: 100px;
      padding: 3px 10px;
    }

    .service-col__more {
      margin-top: 4px;
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent);
    }

    /* ============================================
       PRODUCTS — 自社プロダクト
       ============================================ */
    .products { background: var(--bg-secondary); position: relative; overflow: hidden; }
    .products .section { position: relative; }

    .products__grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
      gap: clamp(10px, 1.4vw, 16px);
    }

    .product-card {
      background: var(--bg-primary);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: clamp(24px, 2.6vw, 32px);
      display: flex;
      flex-direction: column;
      gap: 10px;
      transition: border-color 0.3s ease, transform 0.3s ease;
    }

    .product-card:hover { border-color: var(--accent-secondary); transform: translateY(-2px); }

    .product-card__name { font-size: clamp(18px, 1.8vw, 22px); font-weight: 800; letter-spacing: 0.02em; }
    .product-card__kana { font-size: 11px; color: var(--text-muted); letter-spacing: 0.12em; }
    .product-card__desc { font-size: clamp(12.5px, 1.1vw, 14px); color: var(--text-secondary); line-height: 1.8; flex: 1; }
    .product-card__link { font-size: 12px; font-weight: 600; letter-spacing: 0.08em; color: var(--accent); text-transform: uppercase; }

    /* ============================================
       SHOWCASE — 暗転の見せ場②（AI動画生成）
       ============================================ */
    .showcase {
      position: relative;
      background: var(--bg-dark);
      color: var(--text-on-dark);
      overflow: hidden;
      padding: var(--space-2xl) var(--gutter);
    }

    .showcase__canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0.55;
    }

    .showcase__scrim {
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at center, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.6) 100%);
      pointer-events: none;
    }

    .showcase__inner {
      position: relative;
      z-index: 2;
      max-width: 1200px;
      margin: 0 auto;
    }

    .showcase__eyebrow {
      font-size: clamp(10px, 1vw, 12px);
      font-weight: 500;
      letter-spacing: 0.2em;
      color: var(--accent-secondary);
      text-transform: uppercase;
      margin-bottom: clamp(8px, 1vw, 16px);
    }

    .showcase__title {
      font-size: clamp(26px, 4vw, 48px);
      font-weight: 800;
      line-height: 1.3;
      letter-spacing: -0.02em;
      margin-bottom: var(--space-s);
    }

    .showcase__desc {
      font-size: clamp(13px, 1.25vw, 15px);
      color: rgba(240, 236, 227, 0.75);
      line-height: 2;
      max-width: 620px;
      margin-bottom: var(--space-m);
    }

    .showcase__note {
      font-size: 11px;
      letter-spacing: 0.08em;
      color: rgba(240, 236, 227, 0.45);
    }

    /* ============================================
       VISION — スクロール色塗りステートメント
       ============================================ */
    .philosophy {
      position: relative;
      overflow: hidden;
    }

    .philosophy__text {
      font-size: clamp(24px, 3.6vw, 46px);
      font-weight: 800;
      line-height: 1.9;
      letter-spacing: 0.01em;
      text-align: center;
      max-width: 900px;
      margin: 0 auto;
      padding: var(--space-l) 0;
    }

    /* .charはJSが実行時に生成するためAstroのスコープ外 → :globalで当てる */
    .philosophy__text :global(.char) {
      color: #DDD9D1;
      will-change: color;
    }
    .about-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
      gap: clamp(16px, 2.5vw, 32px);
    }

    .about-card {
      border-top: 1px solid var(--text-primary);
      padding-top: clamp(16px, 2vw, 24px);
    }

    .about-card__title {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: clamp(17px, 1.7vw, 21px);
      font-weight: 700;
      margin-bottom: 10px;
    }

    .about-card__desc { font-size: clamp(12.5px, 1.15vw, 14px); color: var(--text-secondary); line-height: 1.9; margin-bottom: 14px; }

    /* ============================================
       FLOW — 支援の流れ（縦ステップ）
       ============================================ */
    .flow { background: var(--bg-secondary); position: relative; overflow: hidden; }

    .flow__list {
      max-width: 720px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
    }

    .flow__item {
      position: relative;
      display: grid;
      grid-template-columns: 56px 1fr;
      gap: clamp(14px, 2vw, 24px);
      padding: clamp(18px, 2vw, 26px) 0;
    }

    .flow__item:not(:last-child)::after {
      content: '';
      position: absolute;
      left: 27px;
      top: calc(clamp(18px, 2vw, 26px) + 56px);
      bottom: 0;
      width: 1px;
      background: var(--border);
    }

    .flow__num {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      border: 1px solid var(--border);
      background: var(--bg-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 700;
      color: var(--text-muted);
      letter-spacing: 0.05em;
      transition: background 0.45s ease, color 0.45s ease, border-color 0.45s ease, box-shadow 0.45s ease;
    }

    .flow__title {
      font-size: clamp(15px, 1.5vw, 18px);
      font-weight: 700;
      margin-bottom: 4px;
      padding-top: 4px;
      color: var(--text-muted);
      transition: color 0.45s ease;
    }

    .flow__desc {
      font-size: clamp(12.5px, 1.15vw, 14px);
      color: var(--text-muted);
      line-height: 1.8;
      transition: color 0.45s ease;
    }

    /* スクロール連動で現在のステップが点灯する */
    .flow__item.is-active .flow__num {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
      box-shadow: 0 0 0 6px var(--accent-glow);
    }

    .flow__item.is-active .flow__title { color: var(--text-primary); }
    .flow__item.is-active .flow__desc { color: var(--text-secondary); }
  </style>

  <!-- ===== HERO（見せ場①） ===== -->
  <section class="hero" id="hero">
    <video class="hero__video" src="/space-bg/hero.mp4" autoplay loop muted playsinline></video>
    <div class="hero__scrim"></div>
    <div class="hero__inner">
      <p class="hero__eyebrow hero-anim">IZAYOI LLC — HIROSHIMA</p>
      <h1 class="hero__title" id="heroTitle">
        デジタルとアートの力で、<br />
        ブランドを<span class="accent">前進</span>させる。
      </h1>
      <p class="hero__sub hero-anim">
        AI活用支援・SNS運用・Web制作・動画制作。<br />
        戦略から表現まで、ブランドのデジタル体験をひとつのチームで。
      </p>
      <a href="#contact" class="btn-dark hero-anim" style="background: rgba(240,236,227,0.94); color: #16130F; border-color: transparent;">
        30分無料相談 →
      </a>
    </div>
    <div class="hero__scroll">
      <div class="hero__scroll-line"></div>
      Scroll
    </div>
  </section>

  <!-- ===== NEWS ===== -->
  <section class="section" id="news">
    <span class="watermark" aria-hidden="true">NEWS</span>
    <div class="news reveal">
      <div>
        <p class="section__number">News</p>
        <h2 class="section__title">お知らせ</h2>
      </div>
      <div class="news__list">
        {NEWS.map((n) => (
          <div class="news__item">
            <span class="news__date">{n.date}</span>
            <span class="news__tag">{n.tag}</span>
            <span>{n.text}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== AI活用支援（メイン事業） ===== -->
  <section class="section" id="ai">
    <span class="watermark" aria-hidden="true">AI</span>
    <div class="section__header reveal">
      <div>
        <p class="section__number">01 — AI Support</p>
        <h2 class="section__title">AI活用支援</h2>
        <p class="section__lede">
