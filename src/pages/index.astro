  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // === HERO: 文字を1文字ずつ立ち上げる ===
    function splitChars(el: Element) {
      const walk = (node: Node) => {
        if (node.nodeType === Node.TEXT_NODE && node.textContent?.trim()) {
          const frag = document.createDocumentFragment();
          for (const ch of node.textContent) {
            const span = document.createElement('span');
            span.className = 'char';
            span.textContent = ch;
            frag.appendChild(span);
          }
          node.parentNode?.replaceChild(frag, node);
        } else if (node.nodeType === Node.ELEMENT_NODE && (node as Element).tagName !== 'BR') {
          [...node.childNodes].forEach(walk);
        }
      };
      walk(el);
    }

    const heroTitle = document.getElementById('heroTitle');
    if (heroTitle && !reduceMotion) {
      splitChars(heroTitle);
      gsap.fromTo(
        '#heroTitle .char',
        { yPercent: 110, opacity: 0 },
        { yPercent: 0, opacity: 1, duration: 0.9, ease: 'power4.out', stagger: 0.03, delay: 0.35 }
      );
    }

    // === HERO: スクロールで映像がズームしながら白セクションへ ===
    if (!reduceMotion) {
      gsap.to('.hero__video', {
        scale: 1.18,
        opacity: 0.32,
        ease: 'none',
        scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true },
      });
      gsap.to('.hero__inner', {
        y: -70,
        opacity: 0,
        ease: 'none',
        scrollTrigger: { trigger: '.hero', start: '15% top', end: 'bottom top', scrub: true },
      });
    }

    // === AI活用支援: カードのスタガー表示（ピン留めなしの通常スクロール） ===
    const aiTiles = gsap.utils.toArray<HTMLElement>('#aiGrid .tile');
    if (aiTiles.length && !reduceMotion) {
      gsap.set(aiTiles, { opacity: 0, y: 26 });
      ScrollTrigger.batch(aiTiles, {
        start: 'top 86%',
        onEnter: (batch) => gsap.to(batch, { opacity: 1, y: 0, duration: 0.7, stagger: 0.09, ease: 'power2.out' }),
        once: true,
      });
    }

    // === VISION: スクロールに合わせて文字が塗られていく ===
    const philosophyText = document.getElementById('philosophyText');
    if (philosophyText && !reduceMotion) {
      splitChars(philosophyText);
      const chars = philosophyText.querySelectorAll('.char');
      gsap.to(chars, {
        color: (_i: number, el: Element) =>
          el.closest('.accent-word')
            ? getComputedStyle(document.documentElement).getPropertyValue('--accent').trim()
            : getComputedStyle(document.documentElement).getPropertyValue('--text-primary').trim(),
        ease: 'none',
        stagger: 0.35,
        scrollTrigger: {
          trigger: philosophyText,
          start: 'top 80%',
          end: 'bottom 45%',
          scrub: 0.4,
        },
      });
    }

    // === ご支援の流れ: スクロール位置と連動してステップが点灯 ===
    gsap.utils.toArray<HTMLElement>('.flow__item').forEach((item) => {
      ScrollTrigger.create({
        trigger: item,
        start: 'top 60%',
        end: 'bottom 35%',
        toggleClass: { targets: item, className: 'is-active' },
      });
    });

    // Showcase — scroll-scrubbed frame sequence (AI-generated clip)
    const FRAME_COUNT = 48;
    const canvas = document.getElementById('showcase-canvas') as HTMLCanvasElement | null;

    if (canvas && !window.matchMedia('(max-width: 768px)').matches) {
      const ctx = canvas.getContext('2d')!;
      const frames: HTMLImageElement[] = [];
      for (let i = 1; i <= FRAME_COUNT; i++) {
        const img = new Image();
        img.src = `/space-bg/frame-${String(i).padStart(3, '0')}.jpg`;
        frames.push(img);
      }

      const section = canvas.parentElement!;

      function resizeCanvas() {
        const dpr = Math.min(window.devicePixelRatio, 2);
        canvas.width = section.clientWidth * dpr;
        canvas.height = section.clientHeight * dpr;
      }
      resizeCanvas();
      window.addEventListener('resize', resizeCanvas);

      function drawFrame(index: number) {
        const img = frames[index];
        if (!img || !img.complete || img.naturalWidth === 0) return;
        const cw = canvas.width, ch = canvas.height;
        const iw = img.naturalWidth, ih = img.naturalHeight;
        const scale = Math.max(cw / iw, ch / ih);
        const dw = iw * scale, dh = ih * scale;
        ctx.clearRect(0, 0, cw, ch);
        ctx.drawImage(img, (cw - dw) / 2, (ch - dh) / 2, dw, dh);
      }

      let eased = 0;
      (function loop() {
        const rect = section.getBoundingClientRect();
        const vh = window.innerHeight;
        const progress = Math.min(1, Math.max(0, (vh - rect.top) / (vh + rect.height)));
        eased += (progress - eased) * 0.1;
        drawFrame(Math.min(FRAME_COUNT - 1, Math.floor(eased * FRAME_COUNT)));
        requestAnimationFrame(loop);
      })();
    }
  </script>
