    .column-card__title { font-size: clamp(15px, 1.5vw, 18px); font-weight: 800; line-height: 1.5; }
    .column-card__desc { font-size: clamp(12px, 1.05vw, 13.5px); color: var(--text-secondary); line-height: 1.85; flex: 1; }
    .column-card__more { font-size: 11.5px; font-weight: 700; letter-spacing: 0.06em; color: var(--accent); text-transform: uppercase; }

    /* ============================================
       BRUSH ARC — スクロールで描かれる筆ストローク
       ============================================ */
