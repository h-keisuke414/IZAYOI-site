  <script>
    import * as THREE from 'three';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 単語単位で分割（プルアップ用）。テキストノードだけを対象に、要素のclassは保持する
    function splitWords(el: Element) {
      const walk = (node: Node) => {
        if (node.nodeType === Node.TEXT_NODE && node.textContent?.trim()) {
          const frag = document.createDocumentFragment();
          const parts = node.textContent.split(/(\s+)/);
          for (const part of parts) {
            if (!part) continue;
            if (/^\s+$/.test(part)) {
              frag.appendChild(document.createTextNode(part));
            } else {
              const span = document.createElement('span');
              span.className = 'word';
              span.textContent = part;
              frag.appendChild(span);
            }
          }
          node.parentNode?.replaceChild(frag, node);
        } else if (node.nodeType === Node.ELEMENT_NODE && (node as Element).tagName !== 'BR') {
          [...node.childNodes].forEach(walk);
        }
      };
      walk(el);
    }

    function splitChars(el: Element) {
      const walk = (node: Node) => {
        if (node.nodeType === Node.TEXT_NODE && node.textContent?.trim()) {
          const frag = document.createDocumentFragment();
          for (const ch of node.textContent) {
            const span = document.createElement('span');
            span.className = 'char';
            span.textContent = ch;
            frag.appendChild(span);
          }
          node.parentNode?.replaceChild(frag, node);
        } else if (node.nodeType === Node.ELEMENT_NODE && (node as Element).tagName !== 'BR') {
          [...node.childNodes].forEach(walk);
        }
      };
      walk(el);
    }

    function pullUp(targets: NodeListOf<Element> | Element[], opts: { delay?: number; trigger?: Element | null } = {}) {
      gsap.fromTo(
        targets,
        { y: 20, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.7,
          ease: 'power4.out',
          stagger: 0.08,
          delay: opts.delay ?? 0,
          ...(opts.trigger
            ? { scrollTrigger: { trigger: opts.trigger, start: 'top 82%', once: true } }
            : {}),
        }
      );
    }

    // ============================================
    // DATA PAINTING 3D — IZAYOIの文脈を学習した色彩を、実3Dメッシュの波で
    // （Refik Anadol "Unsupervised" へのオマージュ。
    //   学習データ = 広島もみじの朱・瀬戸内の藍・十六夜の月光の金・墨）
    // ============================================
    const paintCanvas = document.getElementById('dataPaint') as HTMLCanvasElement | null;
    if (paintCanvas) {
      const renderer = new THREE.WebGLRenderer({ canvas: paintCanvas, antialias: true });
      renderer.setClearColor(0x0b0a09, 1);

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(55, 1, 0.1, 120);
      camera.position.set(0, 2.3, 6);

      const NOISE_GLSL = `
        uniform float uSeed;
        float hash(vec2 p) {
          p = fract(p * vec2(123.34, 456.21) + uSeed);
          p += dot(p, p + 45.32);
          return fract(p.x * p.y);
        }
        float noise(vec2 p) {
          vec2 i = floor(p);
          vec2 f = fract(p);
          vec2 u = f * f * (3.0 - 2.0 * f);
          return mix(
            mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x),
            mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x),
            u.y
          );
        }
        float fbm(vec2 p) {
          float v = 0.0;
          float a = 0.5;
          for (int i = 0; i < 5; i++) {
            v += a * noise(p);
            p = p * 2.03 + vec2(1.7, 9.2);
            a *= 0.55;
          }
          return v;
        }
      `;

      // IZAYOIの文脈パレット: 墨 → 瀬戸内の藍 → 月藍 → 紅葉の朱 → 金 → 十六夜の月光
      const PALETTE_GLSL = `
        vec3 palette(float t) {
          vec3 sumi   = vec3(0.043, 0.039, 0.035);
          vec3 ai     = vec3(0.132, 0.204, 0.294);
          vec3 tsuki  = vec3(0.416, 0.620, 0.753);
          vec3 momiji = vec3(0.761, 0.345, 0.188);
          vec3 kin    = vec3(0.769, 0.533, 0.235);
          vec3 gekkou = vec3(0.910, 0.722, 0.427);
          t = clamp(t, 0.0, 1.0);
          if (t < 0.28) return mix(sumi, ai, t / 0.28);
          if (t < 0.48) return mix(ai, tsuki, (t - 0.28) / 0.20);
          if (t < 0.66) return mix(tsuki, momiji, (t - 0.48) / 0.18);
          if (t < 0.84) return mix(momiji, kin, (t - 0.66) / 0.18);
          return mix(kin, gekkou, (t - 0.84) / 0.16);
        }
      `;

      const vertexShader = `
        uniform float uTime;
        uniform vec2 uMouse;
        varying float vCi;
        varying vec3 vWorldPos;
        varying vec3 vNormal;
        ${NOISE_GLSL}

        float heightAt(vec2 xy, float t, out vec2 q) {
          vec2 w = xy * 0.16;
          w.y -= t * 1.25;
          q = vec2(
            fbm(w + t * 0.4 + uMouse * 0.25),
            fbm(w + vec2(1.7, 4.6) - t * 0.3)
          );
          return fbm(w + 2.6 * q);
        }

        void main() {
          vec3 pos = position;
          float t = uTime * 0.05;
          float AMP = 3.6;

          vec2 q;
          float h = heightAt(pos.xy, t, q);
          pos.z = (h - 0.5) * AMP;

          // 解析的に滑らかな法線を求める（近傍の高さから接ベクトルを作る）
          float e = 0.45;
          vec2 q2;
          float hx = heightAt(pos.xy + vec2(e, 0.0), t, q2);
          float hy = heightAt(pos.xy + vec2(0.0, e), t, q2);
          vec3 ta = vec3(e, 0.0, (hx - h) * AMP);
          vec3 tb = vec3(0.0, e, (hy - h) * AMP);
          vNormal = normalize(mat3(modelMatrix) * normalize(cross(ta, tb)));

          vCi = h * 1.05 - 0.15 + 0.45 * (q.x - q.y);
          vec4 wp = modelMatrix * vec4(pos, 1.0);
          vWorldPos = wp.xyz;
          gl_Position = projectionMatrix * viewMatrix * wp;
        }
      `;

      const fragmentShader = `
        uniform float uTime;
        uniform vec2 uMouse;
        varying float vCi;
        varying vec3 vWorldPos;
        varying vec3 vNormal;
        ${NOISE_GLSL}
        ${PALETTE_GLSL}
        void main() {
          vec3 n = normalize(vNormal);
          if (n.y < 0.0) n = -n;

          vec3 lightDir = normalize(vec3(-0.4 + uMouse.x * 0.5, 0.8, 0.35 + uMouse.y * 0.3));
          float diff = clamp(dot(n, lightDir), 0.0, 1.0);
          vec3 viewDir = normalize(cameraPosition - vWorldPos);
          vec3 hv = normalize(lightDir + viewDir);
          float spec = pow(clamp(dot(n, hv), 0.0, 1.0), 30.0);

          float detail = fbm(vWorldPos.xz * 0.9 + uTime * 0.03) * 0.14;
          vec3 base = palette(clamp(vCi + detail, 0.0, 1.0));
          vec3 gekkou = vec3(0.910, 0.722, 0.427);
          vec3 col = base * (0.32 + 0.8 * diff) + gekkou * spec * 0.7;

          // 距離フォグ: 奥は墨の靄に沈む
          float dist = length(cameraPosition - vWorldPos);
          float fog = 1.0 - exp(-max(dist - 5.0, 0.0) * 0.085);
          vec3 sumi = vec3(0.055, 0.052, 0.05);
          col = mix(col, sumi, clamp(fog, 0.0, 1.0));

          gl_FragColor = vec4(col, 1.0);
        }
      `;

      const paintUniforms = {
        uTime: { value: 0 },
        uMouse: { value: new THREE.Vector2(0, 0) },
        uSeed: { value: Math.random() * 100 },
      };

      const material = new THREE.ShaderMaterial({
        vertexShader,
        fragmentShader,
        uniforms: paintUniforms,
      });

      const plane = new THREE.Mesh(new THREE.PlaneGeometry(46, 30, 260, 170), material);
      plane.rotation.x = -Math.PI / 2;
      plane.position.set(0, 0, -10);
      scene.add(plane);

      function resizePaint() {
        const dpr = Math.min(window.devicePixelRatio, 1.5);
        const w = paintCanvas!.clientWidth;
        const h = paintCanvas!.clientHeight;
        renderer.setPixelRatio(dpr);
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      }
      resizePaint();
      window.addEventListener('resize', resizePaint);

      let mx = 0, my = 0, emx = 0, emy = 0;
      window.addEventListener('pointermove', (e) => {
        mx = (e.clientX / window.innerWidth - 0.5) * 2.0;
        my = (e.clientY / window.innerHeight - 0.5) * 2.0;
      });

      const start = performance.now();
      function paintFrame() {
        const t = (performance.now() - start) / 1000;
        emx += (mx - emx) * 0.03;
        emy += (my - emy) * 0.03;
        paintUniforms.uTime.value = t;
        paintUniforms.uMouse.value.set(emx, emy);
        // カメラは波の上をゆっくり漂う
        camera.position.x = Math.sin(t * 0.07) * 0.5 + emx * 0.5;
        camera.position.y = 2.3 + Math.sin(t * 0.11) * 0.12 - emy * 0.2;
        camera.lookAt(0, 0.1, -13);
        renderer.render(scene, camera);
        if (!reduceMotion) requestAnimationFrame(paintFrame);
      }
      paintFrame();
    }

    if (!reduceMotion) {
      // HERO: タイトル語プルアップ + 説明/CTAフェード
      pullUp(document.querySelectorAll('#labTitle .word'));
      gsap.fromTo('#labDesc', { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, delay: 0.5, ease: 'expo.out' });
      gsap.fromTo('#labCta', { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, delay: 0.7, ease: 'expo.out' });

      // ABOUT: 見出し語プルアップ
      const labHeading = document.getElementById('labHeading');
      if (labHeading) {
        splitWords(labHeading);
        pullUp(labHeading.querySelectorAll('.word'), { trigger: labHeading });
      }

      // ABOUT: 本文の文字単位スクロールリビール（opacity 0.2 → 1）
      const labBody = document.getElementById('labBody');
      if (labBody) {
        splitChars(labBody);
        gsap.to(labBody.querySelectorAll('.char'), {
          opacity: 1,
          ease: 'none',
          stagger: 0.3,
          scrollTrigger: { trigger: labBody, start: 'top 80%', end: 'bottom 20%', scrub: 0.4 },
        });
      }

      // APPS: 見出し語プルアップ + 各アプリ名のプルアップ
      const featHeading = document.getElementById('featHeading');
      if (featHeading) {
        splitWords(featHeading);
        pullUp(featHeading.querySelectorAll('.word'), { trigger: featHeading });
      }

      document.querySelectorAll('.app-sec').forEach((sec) => {
        const name = sec.querySelector('.app-sec__name');
        if (name) {
          splitWords(name);
          pullUp(name.querySelectorAll('.word'), { trigger: sec });
        }
      });

      // GALLERY: 横スクロールのピン留め（デスクトップのみ）
      const track = document.getElementById('galleryTrack');
      if (track) {
        const mm = gsap.matchMedia();
        mm.add('(min-width: 900px)', () => {
          gsap.to(track, {
            x: () => -(track.scrollWidth - window.innerWidth + 48),
            ease: 'none',
            scrollTrigger: {
              trigger: '.gallery',
              start: 'top top',
              end: () => `+=${track.scrollWidth - window.innerWidth + 48}`,
              pin: true,
              scrub: 0.5,
