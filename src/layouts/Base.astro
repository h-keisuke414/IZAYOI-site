---
import SEO from '../components/SEO.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import '../styles/shared.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, ogImage, ogType, jsonLd } = Astro.props;

// Organization structured data (all pages)
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'IZAYOI合同会社',
  alternateName: 'IZAYOI LLC',
  url: 'https://izayoi-hiroshima.com',
  logo: 'https://izayoi-hiroshima.com/logo.svg',
  description: '広島発のデジタルマーケティング会社。SNS運用代行・HP制作・動画制作・AI導入支援。',
  foundingDate: '2023',
  address: {
    '@type': 'PostalAddress',
    addressLocality: '広島市',
    addressRegion: '広島県',
    addressCountry: 'JP',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'info@izayoi.co.jp',
    contactType: 'customer service',
    availableLanguage: 'Japanese',
  },
  sameAs: [],
};

const mergedJsonLd = jsonLd ?? orgJsonLd;
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="format-detection" content="telephone=no" />
  <meta name="theme-color" content="#FFFFFF" />

  <SEO
    title={title}
    description={description}
    ogImage={ogImage}
    ogType={ogType}
    jsonLd={mergedJsonLd}
  />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts: preconnect + font-display:swap -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Noto+Sans+JP:wght@300;400;500;700;900&family=Almarai:wght@300;400;700;800&family=Instrument+Serif:ital@1&family=Italiana&display=swap"
    onload="this.onload=null;this.rel='stylesheet'"
  />
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Noto+Sans+JP:wght@300;400;500;700;900&family=Almarai:wght@300;400;700;800&family=Instrument+Serif:ital@1&family=Italiana&display=swap" rel="stylesheet" />
  </noscript>
</head>
<body>
  <canvas class="bg-wash" id="bgWash" aria-hidden="true"></canvas>
  <div class="bg-ambient" aria-hidden="true"></div>
  <div class="grain" aria-hidden="true"></div>
  <div class="progress-bar" id="progressBar" aria-hidden="true"></div>
  <Cursor />
  <Nav />

  <main>
    <slot />
  </main>

  <Footer />

  <script>
    import Lenis from 'lenis';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // === Lenis smooth scroll（GSAP tickerと同期） ===
    let lenis: InstanceType<typeof Lenis> | null = null;
    if (!reduceMotion) {
      lenis = new Lenis({ lerp: 0.12 });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => lenis!.raf(time * 1000));
      gsap.ticker.lagSmoothing(0);
    }
    (window as any).__lenis = lenis;

    // === ページ全体のスクロール進捗バー ===
    const progressBar = document.getElementById('progressBar');
    if (progressBar) {
      gsap.set(progressBar, { scaleX: 0 });
      gsap.to(progressBar, {
        scaleX: 1,
        ease: 'none',
        scrollTrigger: { start: 0, end: 'max', scrub: 0.3 },
      });
    }

    // === 背景ウォッシュ: 文脈パレットの水彩がゆっくり流れる（白ページ用） ===
    const washCanvas = document.getElementById('bgWash') as HTMLCanvasElement | null;
    if (washCanvas && document.querySelector('.lab')) {
      washCanvas.remove(); // ダークなラボページでは不要
    } else if (washCanvas) {
      const wgl = washCanvas.getContext('webgl', { antialias: false, alpha: false });
      if (wgl) {
        const washFs = `
          precision highp float;
          uniform vec2 u_res;
          uniform float u_time;
          uniform float u_seed;

          float hash(vec2 p) {
            p = fract(p * vec2(123.34, 456.21) + u_seed);
            p += dot(p, p + 45.32);
            return fract(p.x * p.y);
          }
          float noise(vec2 p) {
            vec2 i = floor(p);
            vec2 f = fract(p);
            vec2 u = f * f * (3.0 - 2.0 * f);
            return mix(
              mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x),
              mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x),
              u.y
            );
          }
          float fbm(vec2 p) {
            float v = 0.0;
            float a = 0.5;
            for (int i = 0; i < 5; i++) {
              v += a * noise(p);
              p = p * 2.03 + vec2(1.7, 9.2);
              a *= 0.55;
            }
            return v;
          }

          void main() {
            vec2 uv = gl_FragCoord.xy / u_res;
            vec2 p = uv;
            p.x *= u_res.x / u_res.y;
            p *= 1.35;

            float t = u_time * 0.02;
            vec2 q = vec2(
              fbm(p + t),
              fbm(p + vec2(2.3, 1.9) - t * 0.8)
            );
            float f = fbm(p + 2.4 * q);

            // 紙の上を、金・藍・朱の水彩がにじむ
            vec3 col = vec3(1.0, 0.996, 0.988);
            col = mix(col, vec3(0.914, 0.804, 0.608), smoothstep(0.46, 0.82, f) * 0.5);
            col = mix(col, vec3(0.729, 0.812, 0.878), smoothstep(0.42, 0.14, f) * 0.34);
            col = mix(col, vec3(0.894, 0.694, 0.588), smoothstep(0.55, 0.8, q.y) * 0.22);

            gl_FragColor = vec4(col, 1.0);
          }
        `;
        const washVs = 'attribute vec2 a_pos; void main() { gl_Position = vec4(a_pos, 0.0, 1.0); }';

        const compileWash = (type: number, src: string) => {
          const s = wgl.createShader(type)!;
          wgl.shaderSource(s, src);
          wgl.compileShader(s);
          return s;
        };
        const washProg = wgl.createProgram()!;
        wgl.attachShader(washProg, compileWash(wgl.VERTEX_SHADER, washVs));
        wgl.attachShader(washProg, compileWash(wgl.FRAGMENT_SHADER, washFs));
        wgl.linkProgram(washProg);
        wgl.useProgram(washProg);

        const washBuf = wgl.createBuffer();
        wgl.bindBuffer(wgl.ARRAY_BUFFER, washBuf);
        wgl.bufferData(wgl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), wgl.STATIC_DRAW);
        const washPos = wgl.getAttribLocation(washProg, 'a_pos');
        wgl.enableVertexAttribArray(washPos);
        wgl.vertexAttribPointer(washPos, 2, wgl.FLOAT, false, 0, 0);

        const washRes = wgl.getUniformLocation(washProg, 'u_res');
        const washTime = wgl.getUniformLocation(washProg, 'u_time');
        wgl.uniform1f(wgl.getUniformLocation(washProg, 'u_seed'), Math.random() * 100);

        function resizeWash() {
          const w = washCanvas!.clientWidth;
          const h = washCanvas!.clientHeight;
          if (washCanvas!.width !== w || washCanvas!.height !== h) {
            washCanvas!.width = w;
            washCanvas!.height = h;
            wgl!.viewport(0, 0, w, h);
          }
        }
        resizeWash();
        window.addEventListener('resize', resizeWash);

        const washStart = performance.now();
        function washFrame() {
          wgl!.uniform2f(washRes, washCanvas!.width, washCanvas!.height);
          wgl!.uniform1f(washTime, (performance.now() - washStart) / 1000);
          wgl!.drawArrays(wgl!.TRIANGLES, 0, 3);
          if (!reduceMotion) requestAnimationFrame(washFrame);
        }
        washFrame();
      }
    }

    // === ウォーターマーク: スクロールで輪郭線が描かれていく（span→SVG変換） ===
    if (!reduceMotion) {
      const svgNS = 'http://www.w3.org/2000/svg';
      document.querySelectorAll('.watermark').forEach((wm) => {
        const word = wm.textContent?.trim();
        if (!word) return;
        const svg = document.createElementNS(svgNS, 'svg');
        svg.setAttribute(
          'class',
          'watermark-svg' + (wm.classList.contains('watermark--dark') ? ' watermark-svg--dark' : '')
        );
        svg.setAttribute('aria-hidden', 'true');
        const text = document.createElementNS(svgNS, 'text');
        text.setAttribute('x', '100%');
        text.setAttribute('y', '0');
        text.setAttribute('text-anchor', 'end');
        text.setAttribute('dominant-baseline', 'hanging');
        text.textContent = word;
        svg.appendChild(text);
        wm.replaceWith(svg);

        const trigger = svg.closest('section') ?? svg.parentElement!;
        gsap.fromTo(
          text,
          { strokeDasharray: 1000, strokeDashoffset: 1000 },
          {
            strokeDashoffset: 0,
            ease: 'none',
            scrollTrigger: { trigger, start: 'top 88%', end: 'top 12%', scrub: 0.5 },
          }
        );
      });
    }

    // === ナビ現在地インジケータ（トップページのセクション連動） ===
    const sectionNavMap: Record<string, string> = {
      ai: 'a[href="/ai"]',
      services: 'a[href="/services"]',
      products: 'a[href="/products"]',
      contact: 'a[href="/#contact"]',
    };
    Object.entries(sectionNavMap).forEach(([id, selector]) => {
      const sec = document.getElementById(id);
      const link = document.querySelector(`.nav__links ${selector}`);
      if (sec && link) {
        ScrollTrigger.create({
          trigger: sec,
          start: 'top 45%',
          end: 'bottom 45%',
          onToggle: (self) => link.classList.toggle('current', self.isActive),
        });
      }
    });

    // === Custom Cursor ===
    const cursor = document.getElementById('cursor')!;
    const cursorDot = document.getElementById('cursorDot')!;
    let cx = 0, cy = 0, dx = 0, dy = 0;

    document.addEventListener('mousemove', (e) => {
      dx = e.clientX;
      dy = e.clientY;
      cursorDot.style.left = dx + 'px';
      cursorDot.style.top = dy + 'px';
    });

    (function cursorLoop() {
      cx += (dx - cx) * 0.15;
      cy += (dy - cy) * 0.15;
      cursor.style.left = cx + 'px';
      cursor.style.top = cy + 'px';
      requestAnimationFrame(cursorLoop);
    })();

    document.querySelectorAll('a, button, .work-card, .service-card').forEach((el) => {
      el.addEventListener('mouseenter', () => cursor.classList.add('hover'));
      el.addEventListener('mouseleave', () => cursor.classList.remove('hover'));
    });

    // === Mobile Nav ===
    const hamburger = document.getElementById('hamburger')!;
    const mobileMenu = document.getElementById('mobileMenu')!;

    hamburger.addEventListener('click', () => {
      hamburger.classList.toggle('active');
      mobileMenu.classList.toggle('open');
      document.body.style.overflow = mobileMenu.classList.contains('open') ? 'hidden' : '';
    });

    mobileMenu.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        hamburger.classList.remove('active');
        mobileMenu.classList.remove('open');
        document.body.style.overflow = '';
      });
    });

    // === Nav scroll ===
    window.addEventListener('scroll', () => {
      document.getElementById('nav')!.classList.toggle('scrolled', window.scrollY > 50);
    }, { passive: true });

    // === Scroll Reveal ===
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          const counter = entry.target.querySelector('[data-count]') as HTMLElement | null;
          if (counter) animateCount(counter);
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll('.reveal').forEach((el, _i) => {
      const parent = el.parentElement;
      if (parent?.classList.contains('reveal-stagger')) {
        const siblings = [...parent.querySelectorAll('.reveal')];
        const idx = siblings.indexOf(el);
        (el as HTMLElement).style.transitionDelay = (idx * 0.1) + 's';
      }
      revealObserver.observe(el);
    });

    // === Count-up ===
    function animateCount(el: HTMLElement) {
      if (el.dataset.counted) return;
      el.dataset.counted = 'true';
      const target = parseInt(el.dataset.count ?? '0');
      const duration = 2000;
      const start = performance.now();
      (function update(now: number) {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.round(eased * target) + '+';
        if (progress < 1) requestAnimationFrame(update);
      })(start);
    }

    // === Smooth scroll for hash links（Lenis経由） ===
    document.querySelectorAll('a[href^="#"]').forEach((a) => {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        const href = (a as HTMLAnchorElement).getAttribute('href');
        if (href) {
          const t = document.querySelector(href);
          if (t && lenis) lenis.scrollTo(t as HTMLElement, { offset: -72 });
          else if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // === Page hero entrance ===
    requestAnimationFrame(() => {
      document.querySelectorAll('.hero-anim').forEach((el, i) => {
        setTimeout(() => {
          (el as HTMLElement).style.transition = 'opacity 0.8s ease, transform 0.8s ease';
          el.classList.add('show');
        }, 300 + i * 180);
      });
    });
  </script>
</body>
</html>
