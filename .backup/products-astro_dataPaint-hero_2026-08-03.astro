  <script>
    import * as THREE from 'three';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 単語単位で分割（プルアップ用）。テキストノードだけを対象に、要素のclassは保持する
    function splitWords(el: Element) {
      const walk = (node: Node) => {
        if (node.nodeType === Node.TEXT_NODE && node.textContent?.trim()) {
          const frag = document.createDocumentFragment();
          const parts = node.textContent.split(/(\s+)/);
          for (const part of parts) {
            if (!part) continue;
            if (/^\s+$/.test(part)) {
              frag.appendChild(document.createTextNode(part));
            } else {
              const span = document.createElement('span');
              span.className = 'word';
              span.textContent = part;
              frag.appendChild(span);
            }
          }
          node.parentNode?.replaceChild(frag, node);
        } else if (node.nodeType === Node.ELEMENT_NODE && (node as Element).tagName !== 'BR') {
          [...node.childNodes].forEach(walk);
        }
      };
      walk(el);
    }

    function splitChars(el: Element) {
      const walk = (node: Node) => {
        if (node.nodeType === Node.TEXT_NODE && node.textContent?.trim()) {
          const frag = document.createDocumentFragment();
          for (const ch of node.textContent) {
            const span = document.createElement('span');
            span.className = 'char';
            span.textContent = ch;
            frag.appendChild(span);
          }
          node.parentNode?.replaceChild(frag, node);
        } else if (node.nodeType === Node.ELEMENT_NODE && (node as Element).tagName !== 'BR') {
          [...node.childNodes].forEach(walk);
        }
      };
      walk(el);
    }

    function pullUp(targets: NodeListOf<Element> | Element[], opts: { delay?: number; trigger?: Element | null } = {}) {
      gsap.fromTo(
        targets,
        { y: 20, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.7,
          ease: 'power4.out',
          stagger: 0.08,
          delay: opts.delay ?? 0,
          ...(opts.trigger
            ? { scrollTrigger: { trigger: opts.trigger, start: 'top 82%', once: true } }
            : {}),
        }
      );
    }

    // ============================================
    // DATA PAINTING 3D — IZAYOIの文脈を学習した色彩を、実3Dメッシュの波で
    // （Refik Anadol "Unsupervised" へのオマージュ。
    //   学習データ = 広島もみじの朱・瀬戸内の藍・十六夜の月光の金・墨）
    // ============================================
    const paintCanvas = document.getElementById('dataPaint') as HTMLCanvasElement | null;
    if (paintCanvas) {
      const renderer = new THREE.WebGLRenderer({ canvas: paintCanvas, antialias: true });
      renderer.setClearColor(0x0b0a09, 1);

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(55, 1, 0.1, 120);
      camera.position.set(0, 2.3, 6);

      const NOISE_GLSL = `
        uniform float uSeed;
        float hash(vec2 p) {
          p = fract(p * vec2(123.34, 456.21) + uSeed);
          p += dot(p, p + 45.32);
          return fract(p.x * p.y);
        }
        float noise(vec2 p) {
          vec2 i = floor(p);
          vec2 f = fract(p);
          vec2 u = f * f * (3.0 - 2.0 * f);
          return mix(
            mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x),
            mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x),
            u.y
          );
        }
        float fbm(vec2 p) {
          float v = 0.0;
          float a = 0.5;
          for (int i = 0; i < 5; i++) {
            v += a * noise(p);
            p = p * 2.03 + vec2(1.7, 9.2);
            a *= 0.55;
          }
          return v;
        }
      `;

      // IZAYOIの文脈パレット: 墨 → 瀬戸内の藍 → 月藍 → 紅葉の朱 → 金 → 十六夜の月光
      const PALETTE_GLSL = `
        vec3 palette(float t) {
          vec3 sumi   = vec3(0.043, 0.039, 0.035);
          vec3 ai     = vec3(0.132, 0.204, 0.294);
          vec3 tsuki  = vec3(0.416, 0.620, 0.753);
          vec3 momiji = vec3(0.761, 0.345, 0.188);
          vec3 kin    = vec3(0.769, 0.533, 0.235);
          vec3 gekkou = vec3(0.910, 0.722, 0.427);
          t = clamp(t, 0.0, 1.0);
          if (t < 0.28) return mix(sumi, ai, t / 0.28);
          if (t < 0.48) return mix(ai, tsuki, (t - 0.28) / 0.20);
          if (t < 0.66) return mix(tsuki, momiji, (t - 0.48) / 0.18);
          if (t < 0.84) return mix(momiji, kin, (t - 0.66) / 0.18);
          return mix(kin, gekkou, (t - 0.84) / 0.16);
        }
      `;

      // 波の高度場。平面メッシュと星屑ワープの両方が同じ場を参照する
      const WAVE_GLSL = `
        float heightAt(vec2 xy, float t, out vec2 q) {
          vec2 w = xy * 0.16;
          w.y -= t * 1.25;
          q = vec2(
            fbm(w + t * 0.4 + uMouse * 0.25),
            fbm(w + vec2(1.7, 4.6) - t * 0.3)
          );
          return fbm(w + 2.6 * q);
        }
      `;

      const vertexShader = `
        uniform float uTime;
        uniform vec2 uMouse;
        varying float vCi;
        varying vec3 vWorldPos;
        varying vec3 vNormal;
        ${NOISE_GLSL}
        ${WAVE_GLSL}

        void main() {
          vec3 pos = position;
          float t = uTime * 0.05;
          float AMP = 3.6;

          vec2 q;
          float h = heightAt(pos.xy, t, q);
          pos.z = (h - 0.5) * AMP;

          // 解析的に滑らかな法線を求める（近傍の高さから接ベクトルを作る）
          float e = 0.45;
          vec2 q2;
          float hx = heightAt(pos.xy + vec2(e, 0.0), t, q2);
          float hy = heightAt(pos.xy + vec2(0.0, e), t, q2);
          vec3 ta = vec3(e, 0.0, (hx - h) * AMP);
          vec3 tb = vec3(0.0, e, (hy - h) * AMP);
          vNormal = normalize(mat3(modelMatrix) * normalize(cross(ta, tb)));

          vCi = h * 1.05 - 0.15 + 0.45 * (q.x - q.y);
          vec4 wp = modelMatrix * vec4(pos, 1.0);
          vWorldPos = wp.xyz;
          gl_Position = projectionMatrix * viewMatrix * wp;
        }
      `;

      const fragmentShader = `
        uniform float uTime;
        uniform vec2 uMouse;
        varying float vCi;
        varying vec3 vWorldPos;
        varying vec3 vNormal;
        ${NOISE_GLSL}
        ${PALETTE_GLSL}
        void main() {
          vec3 n = normalize(vNormal);
          if (n.y < 0.0) n = -n;

          vec3 lightDir = normalize(vec3(-0.4 + uMouse.x * 0.5, 0.8, 0.35 + uMouse.y * 0.3));
          float diff = clamp(dot(n, lightDir), 0.0, 1.0);
          vec3 viewDir = normalize(cameraPosition - vWorldPos);
          vec3 hv = normalize(lightDir + viewDir);
          float spec = pow(clamp(dot(n, hv), 0.0, 1.0), 30.0);

          float detail = fbm(vWorldPos.xz * 0.9 + uTime * 0.03) * 0.14;
          vec3 base = palette(clamp(vCi + detail, 0.0, 1.0));
          vec3 gekkou = vec3(0.910, 0.722, 0.427);
          vec3 col = base * (0.32 + 0.8 * diff) + gekkou * spec * 0.7;

          // 距離フォグ: 奥は墨の靄に沈む
          float dist = length(cameraPosition - vWorldPos);
          float fog = 1.0 - exp(-max(dist - 5.0, 0.0) * 0.085);
          vec3 sumi = vec3(0.055, 0.052, 0.05);
          col = mix(col, sumi, clamp(fog, 0.0, 1.0));

          gl_FragColor = vec4(col, 1.0);
        }
      `;

      const paintUniforms = {
        uTime: { value: 0 },
        uMouse: { value: new THREE.Vector2(0, 0) },
        uSeed: { value: Math.random() * 100 },
      };

      const material = new THREE.ShaderMaterial({
        vertexShader,
        fragmentShader,
        uniforms: paintUniforms,
      });

      const plane = new THREE.Mesh(new THREE.PlaneGeometry(46, 30, 260, 170), material);
      plane.rotation.x = -Math.PI / 2;
      plane.position.set(0, 0, -10);
      scene.add(plane);

      // ============================================
      // GLITTER WARP — Originkit "Glitter Wrap" の星屑ワープを実3D空間へ移植。
      // 2Dオーバーレイではなく波と同じシーン・カメラ・fbm高度場・パレットを共有し、
      // 粒子が波面のうねりに乗ったまま奥から手前へ流れる。
      // 波の山に隠れる粒子は深度テストで実際に隠れる（=本物の奥行き）
      // ============================================
      // 粒子の位置は時刻の純関数。ストリーク（軌跡線）は「少し過去の自分」を
      // 同じ関数で引き直すだけで得られる
      const WARP_GLSL = `
        const float Z_FAR = -35.0;
        const float Z_RANGE = 41.5;

        vec3 warpPos(float seed, float tSec, out float cycleId, out float prog, out float ci) {
          float vmul = 0.6 + 0.8 * hash(vec2(seed, 3.1));
          float phase = seed * 7.7 + tSec * (2.2 * vmul);
          cycleId = floor(phase / Z_RANGE);
          float z = Z_FAR + mod(phase, Z_RANGE);
          // 周回ごとにレーンと高度を引き直す（同じ軌道の反復を防ぐ）
          float x = (hash(vec2(seed, cycleId + 11.0)) - 0.5) * 44.0;
          float ra = hash(vec2(seed, cycleId + 23.0));
          float alt = 0.15 + pow(ra, 2.2) * 5.5;
          prog = (z - Z_FAR) / Z_RANGE;
          // 乱流: 手前へ来るほど揺らぎが育つ（Glitter Wrapのturbulence）
          x += sin(tSec * 1.2 + seed) * 0.6 * prog;
          // 波と同じ高度場に乗せる（平面はx軸-90°回転+z=-10配置なので座標を写像）
          vec2 q;
          float h = heightAt(vec2(x, -(z + 10.0)), tSec * 0.05, q);
          ci = h * 1.05 - 0.15 + 0.45 * (q.x - q.y);
          float y = (h - 0.5) * 3.6 + alt + sin(tSec * 0.7 + seed * 1.3) * 0.12;
          return vec3(x, y, z);
        }

        vec3 warpColor(float seed, float ci) {
          float cHash = hash(vec2(seed, 57.0));
          vec3 base = palette(clamp(ci + 0.2 + cHash * 0.3, 0.0, 1.0));
          vec3 gekkou = vec3(0.910, 0.722, 0.427);
          return mix(base, gekkou, 0.3 + 0.3 * cHash);
        }

        float warpFade(float dist, float z, float prog) {
          float fog = 1.0 - exp(-max(dist - 5.0, 0.0) * 0.085);
          float nearFade = 1.0 - smoothstep(4.5, 6.4, z);
          return (0.25 + 0.75 * prog) * (1.0 - clamp(fog, 0.0, 1.0)) * nearFade;
        }

        // グリッター点滅: 稀に~80msだけ強く光る（Glitter Wrapのflash）
        float warpFlash(float seed, float tSec) {
          float cell = tSec * 1.5 + seed * 7.0;
          float rnd = hash(vec2(seed, floor(cell)));
          return (rnd > 0.93 && fract(cell) < 0.12) ? 3.2 : 1.0;
        }
      `;

      const warpUniforms = {
        uTime: { value: 0 },
        uMouse: paintUniforms.uMouse,
        uSeed: paintUniforms.uSeed,
        uScale: { value: 1 },
        uStreak: { value: 0.3 },
      };

      const warpVertexHead = `
        uniform float uTime;
        uniform vec2 uMouse;
        uniform float uScale;
        uniform float uStreak;
        attribute float aSeed;
        varying vec3 vColor;
        varying float vAlpha;
        ${NOISE_GLSL}
        ${WAVE_GLSL}
        ${PALETTE_GLSL}
        ${WARP_GLSL}
      `;

      const warpFragment = `
        varying vec3 vColor;
        varying float vAlpha;
        void main() {
          vec2 uv = gl_PointCoord - 0.5;
          float d = length(uv);
          if (d > 0.5) discard;
          float core = smoothstep(0.42, 0.05, d);
          float glow = smoothstep(0.5, 0.18, d) * 0.4;
          gl_FragColor = vec4(vColor * (core + glow) * vAlpha, 1.0);
        }
      `;

      const streakFragment = `
        varying vec3 vColor;
        varying float vAlpha;
        void main() {
          gl_FragColor = vec4(vColor * vAlpha, 1.0);
        }
      `;

      const WARP_N = 1300;
      const seedArr = new Float32Array(WARP_N);
      for (let i = 0; i < WARP_N; i++) seedArr[i] = Math.random() * 1000;

      // 粒子本体（加算合成のポイントスプライト）
      const ptsGeo = new THREE.BufferGeometry();
      ptsGeo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(WARP_N * 3), 3));
      ptsGeo.setAttribute('aSeed', new THREE.BufferAttribute(seedArr, 1));
      const ptsMat = new THREE.ShaderMaterial({
        uniforms: warpUniforms,
        vertexShader: `
          ${warpVertexHead}
          void main() {
            float cycleId, prog, ci;
            vec3 p = warpPos(aSeed, uTime, cycleId, prog, ci);
            vec4 mv = viewMatrix * vec4(p, 1.0);
            gl_Position = projectionMatrix * mv;

            float dist = -mv.z;
            float flash = warpFlash(aSeed, uTime);
            float rs = hash(vec2(aSeed, 41.0));
            float baseSize = 0.045 + rs * rs * 0.11;
            gl_PointSize = clamp(baseSize * flash * uScale / max(dist, 0.1), 1.2, 20.0);

            vColor = warpColor(aSeed, ci) * flash;
            vAlpha = warpFade(dist, p.z, prog) * (flash > 1.0 ? 1.0 : 0.85);
          }
        `,
        fragmentShader: warpFragment,
        transparent: true,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
      });
      const warpPoints = new THREE.Points(ptsGeo, ptsMat);
      warpPoints.frustumCulled = false;
      scene.add(warpPoints);

      // ストリーク: 各粒子の現在位置と uStreak 秒前の位置を結ぶ線分
      const lineSeed = new Float32Array(WARP_N * 2);
      const lineTip = new Float32Array(WARP_N * 2);
      for (let i = 0; i < WARP_N; i++) {
        lineSeed[i * 2] = seedArr[i];
        lineSeed[i * 2 + 1] = seedArr[i];
        lineTip[i * 2] = 0;
        lineTip[i * 2 + 1] = 1;
      }
      const lineGeo = new THREE.BufferGeometry();
      lineGeo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(WARP_N * 2 * 3), 3));
      lineGeo.setAttribute('aSeed', new THREE.BufferAttribute(lineSeed, 1));
      lineGeo.setAttribute('aTip', new THREE.BufferAttribute(lineTip, 1));
      const lineMat = new THREE.ShaderMaterial({
        uniforms: warpUniforms,
        vertexShader: `
          ${warpVertexHead}
          attribute float aTip;
          void main() {
            float cycleId, prog, ci;
            vec3 head = warpPos(aSeed, uTime, cycleId, prog, ci);
            float cycleIdP, progP, ciP;
            vec3 tail = warpPos(aSeed, uTime - uStreak, cycleIdP, progP, ciP);
            // リスポーン直後は過去位置が前周回のもの → 画面を横切る線になるので潰す
            if (abs(cycleIdP - cycleId) > 0.5) tail = head;
            vec3 p = mix(tail, head, aTip);
            vec4 mv = viewMatrix * vec4(p, 1.0);
            gl_Position = projectionMatrix * mv;

            vColor = warpColor(aSeed, ci);
            // 尾側は0へフェード。頭側もGlitter Wrap同様、点の半分の明るさ
            vAlpha = warpFade(-mv.z, p.z, prog) * aTip * 0.5;
          }
        `,
        fragmentShader: streakFragment,
        transparent: true,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
      });
      const warpStreaks = new THREE.LineSegments(lineGeo, lineMat);
      warpStreaks.frustumCulled = false;
      scene.add(warpStreaks);

      function resizePaint() {
        const dpr = Math.min(window.devicePixelRatio, 1.5);
        const w = paintCanvas!.clientWidth;
        const h = paintCanvas!.clientHeight;
        renderer.setPixelRatio(dpr);
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        // ポイントサイズの透視スケール（描画バッファ実ピクセル基準）
        warpUniforms.uScale.value = (h * dpr) / (2 * Math.tan((55 * Math.PI) / 360));
      }
      resizePaint();
      window.addEventListener('resize', resizePaint);

      let mx = 0, my = 0, emx = 0, emy = 0;
      window.addEventListener('pointermove', (e) => {
        mx = (e.clientX / window.innerWidth - 0.5) * 2.0;
        my = (e.clientY / window.innerHeight - 0.5) * 2.0;
      });

      const start = performance.now();
      function paintFrame() {
        const t = (performance.now() - start) / 1000;
        emx += (mx - emx) * 0.03;
        emy += (my - emy) * 0.03;
        paintUniforms.uTime.value = t;
        paintUniforms.uMouse.value.set(emx, emy);
        warpUniforms.uTime.value = t;
        // カメラは波の上をゆっくり漂う
        camera.position.x = Math.sin(t * 0.07) * 0.5 + emx * 0.5;
        camera.position.y = 2.3 + Math.sin(t * 0.11) * 0.12 - emy * 0.2;
        camera.lookAt(0, 0.1, -13);
        renderer.render(scene, camera);
        if (!reduceMotion) requestAnimationFrame(paintFrame);
      }
      paintFrame();
    }

    if (!reduceMotion) {
      // HERO: タイトル語プルアップ + 説明/CTAフェード
      pullUp(document.querySelectorAll('#labTitle .word'));
      gsap.fromTo('#labDesc', { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, delay: 0.5, ease: 'expo.out' });
      gsap.fromTo('#labCta', { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, delay: 0.7, ease: 'expo.out' });

      // ABOUT: 見出し語プルアップ
      const labHeading = document.getElementById('labHeading');
      if (labHeading) {
        splitWords(labHeading);
        pullUp(labHeading.querySelectorAll('.word'), { trigger: labHeading });
      }

      // ABOUT: 本文の文字単位スクロールリビール（opacity 0.2 → 1）
      const labBody = document.getElementById('labBody');
      if (labBody) {
        splitChars(labBody);
        gsap.to(labBody.querySelectorAll('.char'), {
          opacity: 1,
          ease: 'none',
          stagger: 0.3,
          scrollTrigger: { trigger: labBody, start: 'top 80%', end: 'bottom 20%', scrub: 0.4 },
        });
      }

      // APPS: 見出し語プルアップ + 各アプリ名のプルアップ
      const featHeading = document.getElementById('featHeading');
      if (featHeading) {
        splitWords(featHeading);
        pullUp(featHeading.querySelectorAll('.word'), { trigger: featHeading });
      }

      document.querySelectorAll('.app-sec').forEach((sec) => {
        const name = sec.querySelector('.app-sec__name');
        if (name) {
          splitWords(name);
          pullUp(name.querySelectorAll('.word'), { trigger: sec });
        }
      });

      // GALLERY: 横スクロールのピン留め（デスクトップのみ）
      const track = document.getElementById('galleryTrack');
      if (track) {
        const mm = gsap.matchMedia();
        mm.add('(min-width: 900px)', () => {
          gsap.to(track, {
            x: () => -(track.scrollWidth - window.innerWidth + 48),
            ease: 'none',
            scrollTrigger: {
              trigger: '.gallery',
              start: 'top top',
              end: () => `+=${track.scrollWidth - window.innerWidth + 48}`,
              pin: true,
              scrub: 0.5,
              invalidateOnRefresh: true,
            },
          });
        });
      }

      // ============================================
      // DECODE — 見出しが文字化けから復号されるスクランブル演出
      // ============================================
      const SCRAMBLE_POOL = 'アイウカサタナハマヤラワ0123456789ABCDEFXYZ#*/△◻︎';
      function decodeIn(el: HTMLElement, duration = 1100) {
        const orig = el.textContent ?? '';
        if (!orig.trim()) return;
        const start = performance.now();
        (function tick() {
          const p = Math.min((performance.now() - start) / duration, 1);
          const reveal = Math.floor(orig.length * p);
          el.textContent =
            orig.slice(0, reveal) +
            [...orig.slice(reveal)]
              .map((c) => (/\s/.test(c) ? c : SCRAMBLE_POOL[(Math.random() * SCRAMBLE_POOL.length) | 0]))
              .join('');
          if (p < 1) requestAnimationFrame(tick);
          else el.textContent = orig;
        })();
      }

      const decodeTargets = document.querySelectorAll<HTMLElement>(
        '.gallery__title, .app-sec__tagline, .lab-outro__headline span'
      );
      const decodeSeen = new WeakSet<Element>();
      const decodeIO = new IntersectionObserver(
        (entries) => {
          entries.forEach((en, i) => {
            if (en.isIntersecting && !decodeSeen.has(en.target)) {
              decodeSeen.add(en.target);
              setTimeout(() => decodeIn(en.target as HTMLElement), i * 140);
              decodeIO.unobserve(en.target);
            }
          });
        },
        { threshold: 0.4 }
      );
      decodeTargets.forEach((el) => decodeIO.observe(el));

      // ============================================
      // TILT — ワークカード / アプリビジュアルの3Dチルト + グレア
      // ============================================
      if (window.matchMedia('(pointer: fine)').matches) {
        document.querySelectorAll<HTMLElement>('.work-card, .app-sec__visual').forEach((card) => {
          card.classList.add('tilt');
          card.addEventListener('mousemove', (e) => {
            const r = card.getBoundingClientRect();
            const px = (e.clientX - r.left) / r.width - 0.5;
            const py = (e.clientY - r.top) / r.height - 0.5;
            card.style.transform = `perspective(900px) rotateX(${(-py * 7).toFixed(2)}deg) rotateY(${(px * 9).toFixed(2)}deg) translateY(-2px)`;
            card.style.setProperty('--gx', `${((px + 0.5) * 100).toFixed(1)}%`);
            card.style.setProperty('--gy', `${((py + 0.5) * 100).toFixed(1)}%`);
          });
          card.addEventListener('mouseleave', () => {
            card.style.transform = '';
          });
        });
      }

      // ============================================
      // EMBERS — 金の火の粉が立ち上る（十六夜の月光の欠片）
      // 画面内にある間だけ描画してGPUを守る
      // ============================================
      const embers = document.getElementById('appsEmbers') as HTMLCanvasElement | null;
      if (embers) {
        const ectx = embers.getContext('2d')!;
        const sec = embers.parentElement!;
        let ew = 0, eh = 0;
        const eresize = () => {
          const dpr = Math.min(window.devicePixelRatio, 1.5);
          ew = sec.clientWidth;
          eh = sec.clientHeight;
          embers.width = ew * dpr;
          embers.height = eh * dpr;
          ectx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };
        eresize();
        window.addEventListener('resize', eresize);

        const EN = 70;
        const sparks = Array.from({ length: EN }, () => ({
          x: Math.random(),
          y: Math.random(),
          s: 0.5 + Math.random() * 1.5,
          v: 0.03 + Math.random() * 0.06,
          drift: Math.random() * 6.28,
          fl: Math.random() * 6.28,
        }));

        let embersRun = false;
        let last = 0;
        function emberLoop(t: number) {
          if (!embersRun) return;
          const dt = Math.min((t - last) / 1000, 0.05);
          last = t;
          ectx.clearRect(0, 0, ew, eh);
          for (const p of sparks) {
            p.y -= p.v * dt;
            p.drift += dt * 0.7;
            p.fl += dt * (2 + p.s);
            if (p.y < -0.02) { p.y = 1.02; p.x = Math.random(); }
            const x = p.x * ew + Math.sin(p.drift) * 16;
            const y = p.y * eh;
            const edge = Math.min(p.y / 0.12, (1.04 - p.y) / 0.12, 1);
            const a = (0.2 + 0.4 * Math.abs(Math.sin(p.fl))) * Math.max(edge, 0);
            ectx.beginPath();
            ectx.fillStyle = `rgba(232, 184, 109, ${a.toFixed(3)})`;
            ectx.arc(x, y, p.s, 0, 6.2832);
            ectx.fill();
          }
          requestAnimationFrame(emberLoop);
        }

        new IntersectionObserver(
          ([en]) => {
            if (en.isIntersecting && !embersRun) {
              embersRun = true;
              last = performance.now();
              requestAnimationFrame(emberLoop);
            } else if (!en.isIntersecting) {
              embersRun = false;
            }
          },
          { rootMargin: '120px' }
        ).observe(sec);
      }
    }

    // ============================================
    // EMOJI BURST — 「？」の箱を押すと絵文字が弾け飛ぶ
    // （Originkit Mobile Haptics のバニラ移植。壁なし・重力あり）
    // ============================================
    const emojiBtn = document.getElementById('emojiBtn') as HTMLButtonElement | null;
    const emojiLayer = document.getElementById('emojiLayer');
    const outroSec = document.querySelector('.lab-outro') as HTMLElement | null;
    if (emojiBtn && emojiLayer && outroSec) {
      const EMOJIS = ['🎉','✨','😄','🔥','💥','⭐','💖','🤩','👍','🥳','🎊','😎','😡','🏃‍♂️','⛳️','🎨','🍖'];
      const BURST = 23;
      const POWER = 16;
      const SPREAD = 55;
      const GRAV = 4 * 0.15;
      const LIFE = 260;
      const MAX = 140;
      type Spark = { el: HTMLSpanElement; x: number; y: number; vx: number; vy: number; rot: number; vrot: number; size: number; life: number };
      const parts: Spark[] = [];
      let eRaf = 0;
      let eLast = 0;

      function emojiStep(ts: number) {
        let dt = eLast ? (ts - eLast) / 16.6667 : 1;
        eLast = ts;
        if (dt > 3) dt = 3;
        const W = outroSec!.clientWidth;
        const H = outroSec!.clientHeight;
        for (let i = parts.length - 1; i >= 0; i--) {
          const p = parts[i];
          p.vy += GRAV * dt;
          p.x += p.vx * dt;
          p.y += p.vy * dt;
          p.rot += p.vrot * dt;
          p.life -= dt;
          if (p.life <= 0 || p.y > H + p.size * 2.5 || p.x < -p.size * 3 || p.x > W + p.size * 3) {
            p.el.remove();
            parts.splice(i, 1);
            continue;
          }
          p.el.style.opacity = String(p.life < 22 ? Math.max(0, p.life / 22) : 1);
          p.el.style.transform = `translate(${p.x}px, ${p.y}px) rotate(${p.rot}deg)`;
        }
        if (parts.length) eRaf = requestAnimationFrame(emojiStep);
        else { eRaf = 0; eLast = 0; }
      }

      function emojiBurst() {
        const cr = outroSec!.getBoundingClientRect();
        const or = emojiBtn!.getBoundingClientRect();
        const ox = or.left - cr.left + or.width / 2;
        const oy = or.top - cr.top + or.height / 2;
        // 箱を小突く
        if (typeof emojiBtn!.animate === 'function') {
          const s = 6;
          emojiBtn!.animate(
            [
              { transform: 'translate(0, 0) rotate(0deg)' },
              { transform: `translate(${s}px, ${-s * 0.6}px) rotate(-2.5deg)` },
              { transform: `translate(${-s}px, ${s * 0.3}px) rotate(2.5deg)` },
              { transform: `translate(${s * 0.5}px, 0) rotate(-1deg)` },
              { transform: 'translate(0, 0) rotate(0deg)' },
            ],
            { duration: 260, easing: 'cubic-bezier(.36,.07,.19,.97)' }
          );
        }
        const size = window.innerWidth < 700 ? 38 : 51;
        for (let k = 0; k < BURST; k++) {
          if (parts.length >= MAX) break;
          const el = document.createElement('span');
          el.textContent = EMOJIS[(Math.random() * EMOJIS.length) | 0];
          el.style.cssText = `position:absolute;left:0;top:0;font-size:${size}px;line-height:1;will-change:transform,opacity;pointer-events:none;user-select:none;`;
          el.setAttribute('aria-hidden', 'true');
          emojiLayer!.appendChild(el);
          const ang = ((-90 + (Math.random() * 2 - 1) * SPREAD) * Math.PI) / 180;
          const speed = POWER * (0.65 + Math.random() * 0.8);
          parts.push({
            el,
            x: ox - size / 2,
            y: oy - size / 2,
            vx: Math.cos(ang) * speed,
            vy: Math.sin(ang) * speed,
            rot: Math.random() * 360,
            vrot: (Math.random() * 2 - 1) * 14,
            size,
            life: LIFE,
          });
        }
        if (!eRaf) { eLast = 0; eRaf = requestAnimationFrame(emojiStep); }
      }

      emojiBtn.addEventListener('pointerdown', emojiBurst);

      // 自動バースト（セクションが見えている間だけ・2.2秒周期）
      if (!reduceMotion) {
        let timer = 0;
        new IntersectionObserver(
          ([en]) => {
            if (en.isIntersecting && !timer) {
              emojiBurst();
              timer = window.setInterval(emojiBurst, 2200);
            } else if (!en.isIntersecting && timer) {
              clearInterval(timer);
              timer = 0;
            }
          },
          { threshold: 0.35 }
        ).observe(outroSec);
      }
    }
  </script>
</Base>
